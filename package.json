{
  "name": "lnhf",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/patch-tinacms-status-badges.mjs && ASTRO_DEV_BACKGROUND=0 tinacms dev -c \"ASTRO_DEV_BACKGROUND=0 astro dev\"",
    "build": "node scripts/patch-tinacms-status-badges.mjs && tinacms build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean:content": "rm -rf node_modules/.astro && astro sync",
    "db:migrate": "netlify database migrations apply",
    "db:migrate:neon": "node scripts/apply-neon-migrations.mjs",
    "postinstall": "node scripts/patch-tinacms-status-badges.mjs",
    "netlify:dev": "astro dev stop && netlify dev"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/netlify": "^8.1.3",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/jost": "^5.2.8",
    "@netlify/database": "^1.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.0.3",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "astro-social-share": "^2.2.0",
    "netlify-identity-widget": "^2.0.3",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@tinacms/cli": "^2.5.6",
    "@types/netlify-identity-widget": "^1.9.7",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
