---
// Nav.astro
const currentPath = Astro.url.pathname;
console.log('Current path:', currentPath);
---

<header class="nav" role="banner" id="nav">
  <div class="nav--container container">
    <a href="/" class="nav--logo" aria-label="Lower Notley Hall Farm — Home">
      <div class="nav--logo-svg">
        <img src="/images/logo.svg" alt="" aria-hidden="true" class="nav--logo-lg" />
        <img src="/images/cropped-favicon-270x270.png" alt="" aria-hidden="true" class="nav--logo-sm" />
      </div>
      <span class="nav--logo-text">
        <span class="nav--logo-name">Lower Notley Hall Farm</span>
        <span class="nav--logo-tagline"><span>Southern Maryland</span> Waterfront Weddings</span>
      </span>
    </a>
    <!-- Mobile hamburger -->
    <button
      class="nav--hamburger"
      id="menu-toggle"
      aria-label="Open navigation menu"
      aria-controls="nav-menu"
      aria-expanded="false"
    >
      <span class="nav--hamburger-bar"></span>
      <span class="nav--hamburger-bar"></span>
      <span class="nav--hamburger-bar"></span>
    </button>
    <nav class="nav--links" aria-label="Primary navigation" id="nav-menu">
      <ul role="menubar" aria-orientation="horizontal">
        <li role="menuitem" aria-current={currentPath === '/' ? 'page' : undefined}><a href="/">Home</a></li>
        <li class="nav--links-na" role="menuitem" aria-current={currentPath === '/tours' ? 'page' : undefined}><a href="/tours/" data-umami-event="Tour Link Click" data-umami-event-location="Main Menu">Book a Tour</a></li>
        <li role="menuitem" aria-current={currentPath === '/about/' ? 'page' : undefined}><a href="/about/">About</a></li>
        <li role="menuitem" aria-current={currentPath === '/offerings/' ? 'page' : undefined}><a href="/offerings/">What We Offer</a></li>
        <li role="menuitem" aria-current={currentPath === '/pricing/' ? 'page' : undefined}><a href="/pricing/" data-umami-event="Pricing Link Click" data-umami-event-location="Main Menu">Pricing</a></li>
        <li role="menuitem" aria-current={currentPath === '/faqs/' ? 'page' : undefined}><a href="/faqs/">FAQs</a></li>
        <li role="menuitem" aria-current={currentPath === '/blog/' ? 'page' : undefined}><a href="/blog/">Blog</a></li>
        <li role="menuitem" aria-current={currentPath === '/vendors/' ? 'page' : undefined}><a href="/vendors/">Vendors</a></li>
        <li role="menuitem" aria-current={currentPath === '/contact/' ? 'page' : undefined}><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <div class="nav--actions">
      <!-- Book Now CTA -->
      <a href="/tours/" class="btn btn--primary btn--sm" data-umami-event="Tour Link Click" data-umami-event-location="Main Menu">Book a Tour</a>
    </div>
  </div>
</header>

<script>
  // ── Mobile menu toggle ──────────────────────────────────────────
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const mobileMenu = document.getElementById('nav-menu') as HTMLDivElement;

  menuToggle?.addEventListener('click', () => {
    console.log(mobileMenu);
    const isOpen = mobileMenu.classList.contains('is-expanded');
    mobileMenu.classList.toggle('is-expanded', !isOpen);
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-expanded');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  const nav = document.querySelector("#nav") as HTMLElement;
  const observer = new IntersectionObserver(
    ([e]) => e.target.classList.toggle("is-stuck", e.intersectionRatio < 1),
    { threshold: [1] }
  );

  observer.observe(nav);

</script>

<style>
  .nav {
    container: nav / inline-size;
    position: sticky;
    inset: -1px 0 auto 0;
    z-index: 100;
    background: rgba(250, 248, 243, 0.93);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(181, 146, 76, 0.15);
  }
  .nav--container {
    position: relative;
    display: grid;
    align-items: center;
    justify-content: space-between;
    justify-items: end;
    grid-template-columns: auto 1fr auto;
    gap: 0 var(--space-5);
    padding-block: var(--space-3);
    height: auto;
    transition: height var(--transition-slow);
  }
  .nav--logo-svg { 
    position: relative;
    height: 150px; 
    width: 150px;
    transition: height var(--transition-slow), width var(--transition-slow);
  }
  .nav--logo-lg,
  .nav--logo-sm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity var(--transition-slow);
  }
  .nav--logo-lg { opacity: 1; pointer-events: auto; }
  .nav--logo-sm { opacity: 0; pointer-events: none; }
  .nav--logo {
    display: grid;
    grid-template-columns: max-content auto;
    align-items: center;
    gap: var(--space-3);
  }
  .nav--logo-text {
    display: grid;
  }
  .nav--logo-name {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--color-bark);
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .nav--logo-tagline {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--color-gold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .nav--links ul {
    display: flex;
    justify-content: space-evenly;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 1rem;
  }
  .nav--links li[aria-current="page"] a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .nav--links li {
    margin: 0;
  }
  .nav--hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }
  .nav--hamburger-bar {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--color-text-muted);
    transition: background var(--transition-fast);
  }
  .nav.is-stuck {
    .nav--logo-lg { opacity: 0; pointer-events: none; }
    .nav--logo-sm { opacity: 1; pointer-events: auto; }
    .nav--logo-svg { height: 45px; width: 45px; }
    .nav--logo-name {
      font-size: 1.05rem;
    }
    .nav--logo-tagline {
      font-size: 0.5rem;
    }
  }
  @container nav (width < 600px) {
    .nav--logo-tagline span { display: none; }
    .nav--container { padding-inline: var(--space-2); gap: 0 var(--space-2); }
    .nav--actions { display: none; }
    .nav--links.is-expanded ul {
      flex-direction: column;
      gap: var(--space-2);
      background: var(--color-white);
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      padding: var(--space-6);
      box-shadow: var(--shadow-lg);
    }
  }
  @container nav (width < 900px) {
    .nav--container {
      gap: 0 var(--space-2);
    }
    .nav--logo-lg { opacity: 0; pointer-events: none; }
    .nav--logo-sm { opacity: 1; pointer-events: auto; }
    .nav--logo-svg { height: 45px; width: 45px; }
    .nav--links:not(.is-expanded) { display: none; }
    .nav--logo-name {
      font-size: 1.05rem;
    }
    .nav--logo-tagline {
      font-size: 0.5rem;
    }
  }
  @container nav (width >= 600px) {
    .nav--links-na { display: none; }
  }
  @container nav (width >= 900px) {
    .nav--hamburger { display: none; }
  }
</style>

