---
// Nav.astro

---

<header class="nav" role="banner">
  <div class="nav__container container">

    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Lower Notley Hall Farm — Home">
      <img src="/logo.svg" alt="Lower Notley Hall Farm crest" width="52" height="58" loading="eager" />
      <span class="nav__logo-text">
        <span class="nav__logo-name">Lower Notley Hall Farm</span>
        <span class="nav__logo-tagline">Southern Maryland Waterfront Weddings</span>
      </span>
    </a>

    <!-- Desktop nav links -->
    <nav class="nav__links" aria-label="Primary navigation">
      <ul role="list">
        <li><a href="/" class="nav__link">Home</a></li>
        <li><a href="/about" class="nav__link">About</a></li>
        <li><a href="/pricing" class="nav__link">Pricing</a></li>
        <li><a href="/faqs" class="nav__link">FAQs</a></li>
        <li><a href="/blog" class="nav__link">Blog</a></li>
        <li><a href="/vendors" class="nav__link">Vendors</a></li>
        <li><a href="/contact" class="nav__link">Contact</a></li>
      </ul>
    </nav>

    <!-- Right actions -->
    <div class="nav__actions">
      <!-- Pagefind search toggle -->
       <!-- <Search /> -->
      <!-- Book Now CTA -->
      <a href="/booking" class="btn btn--primary btn--sm">Book a Tour</a>

      <!-- Mobile hamburger -->
      <button
        class="nav__hamburger"
        id="menu-toggle"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="mobile-menu" role="dialog" aria-label="Navigation menu" hidden>
    <nav aria-label="Mobile navigation">
      <ul role="list">
        <li><a href="/" class="nav__mobile-link">Home</a></li>
        <li><a href="/about" class="nav__mobile-link">About</a></li>
        <li><a href="/booking" class="nav__mobile-link">Book a Tour</a></li>
        <li><a href="/pricing" class="nav__mobile-link">Pricing</a></li>
        <li><a href="/faqs" class="nav__mobile-link">FAQs</a></li>
        <li><a href="/blog" class="nav__mobile-link">Blog</a></li>
        <li><a href="/vendors" class="nav__mobile-link">Vendors</a></li>
        <li><a href="/contact" class="nav__mobile-link">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- Search dialog -->
<div class="search-dialog" id="search-dialog" role="dialog" aria-label="Site search" aria-modal="true" hidden>
  <div class="search-dialog__backdrop" id="search-backdrop"></div>
  <div class="search-dialog__panel">
    <div class="search-dialog__header">
      <h2 class="search-dialog__title">Search</h2>
      <button class="search-dialog__close" id="search-close" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="search-container"></div>
  </div>
</div>

<script>
  // ── Mobile menu toggle ──────────────────────────────────────────
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLDivElement;

  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu.hidden;
    mobileMenu.hidden = isOpen;
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.hidden = true;
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  // ── Highlight active nav link ───────────────────────────────────
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll<HTMLAnchorElement>('.nav__link, .nav__mobile-link').forEach(link => {
    const href = new URL(link.href).pathname.replace(/\/$/, '') || '/';
    if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
      link.setAttribute('aria-current', 'page');
      link.classList.add('is-active');
    }
  });
</script>

<style>
  .nav {
    container: nav / inline-size;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(250, 248, 243, 0.93);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(181, 146, 76, 0.15);
    transition: padding var(--transition-slow);
  }

  .nav__container {
    display: grid;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    height: var(--nav-height);
    @container nav (width >= 600px) {
      grid-template-columns: auto 1fr auto;
    }
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo img {
    height: 38px;
    width: auto;
    /* retain natural color on light nav */
  }

  .nav__logo-text {
    display: flex;
    flex-direction: column;
  }

  .nav__logo-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--color-bark);
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .nav__logo-tagline {
    font-family: var(--font-body);
    font-size: 0.60rem;
    font-weight: 300;
    color: var(--color-gold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Desktop links */
  .nav__links { display: none; }

  .nav__links ul {
    display: flex;
    justify-content: space-evenly;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 1rem;
  }

  .nav__link {
    display: inline-block;
    padding: 0;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.70rem;
    font-weight: 300;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .nav__link:hover,
  .nav__link.is-active,
  .nav__link[aria-current="page"] {
    color: var(--color-gold);
  }

  /* Right actions */
  .nav__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .nav__search-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    transition: color var(--transition-fast);
  }
  .nav__search-btn:hover { color: var(--color-gold); }

  /* Hamburger */
  .nav__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav__hamburger-bar {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--color-text-muted);
    transition: background var(--transition-fast);
  }

  .nav__hamburger:hover .nav__hamburger-bar { background: var(--color-gold); }

  /* Mobile menu */
  .nav__mobile {
    background: rgba(250, 248, 243, 0.97);
    border-top: 1px solid var(--color-mist);
    padding: var(--space-6) var(--space-6) var(--space-8);
  }

  .nav__mobile ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav__mobile-link {
    display: block;
    padding: var(--space-3) var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav__mobile-link:hover,
  .nav__mobile-link.is-active {
    color: var(--color-gold);
    border-bottom-color: rgba(181,146,76,0.25);
  }

  /* Search dialog */
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: var(--space-16);
  }

  .search-dialog[hidden] { display: none; }

  .search-dialog__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(61,46,30,0.5);
    backdrop-filter: blur(4px);
  }

  .search-dialog__panel {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin-inline: var(--space-4);
    background: var(--color-warm-white);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .search-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-mist);
  }

  .search-dialog__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 300;
    color: var(--color-bark);
  }

  .search-dialog__close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: var(--space-2);
    display: flex;
    transition: color var(--transition-fast);
  }
  .search-dialog__close:hover { color: var(--color-gold); }

  #search-container {
    padding: var(--space-4) var(--space-6) var(--space-6);
    max-height: 60vh;
    overflow-y: auto;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (min-width: 1024px) {
    .nav__links  { display: block; }
    .nav__hamburger { display: none; }
  }
</style>

