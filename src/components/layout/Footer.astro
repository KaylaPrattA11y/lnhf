---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">

  <!-- Map + Contact band -->
  <div class="footer__map-band">
    <div class="footer__map-wrap">
      <iframe
        title="Lower Notley Hall Farm location on Google Maps"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3120!2d-76.6182!3d38.3844!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b76b4b86d58741%3A0x589171fbc51c98e1!2sLower%20Notley%20Hall%20Farm!5e0!3m2!1sen!2sus!4v1715000000000!5m2!1sen!2sus"
        width="100%"
        height="320"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        aria-label="Google Maps showing Lower Notley Hall Farm at 36290 Notley Manor Ln, Chaptico MD"
      ></iframe>
    </div>

    <div class="footer__contact-info container">
      <div class="footer__contact-grid">
        <div>
          <h3 class="footer__heading">Lower Notley Hall Farm</h3>
          <address>
            <p>36290 Notley Manor Ln<br />Chaptico, MD 20621</p>
            <p>
              <a href="tel:3017692030">(301) 769-2030</a><br />
              <a href="https://goo.gl/maps/VqxhArtwqqGCk9bE9" target="_blank" rel="noopener noreferrer">
                Get Directions
              </a>
            </p>
          </address>
        </div>

        <div>
          <h3 class="footer__heading">Quick Links</h3>
          <nav aria-label="Footer navigation">
            <ul class="footer__link-list">
              <li><a href="/">Home</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/booking">Book a Tour</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/faqs">FAQs</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/vendors">Vendors</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </nav>
        </div>

        <div>
          <h3 class="footer__heading">Connect</h3>
          <ul class="footer__link-list">
            <li>
              <a
                href="https://www.facebook.com/Lower-Notley-Hall-Farm-Wedding-Venue-1629580437060850/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Like us on Facebook (opens in new tab)"
              >
                Facebook
              </a>
            </li>
            <li>
              <a
                href="https://www.google.com/search?q=lower+notley+hall+farm#lrd=0x89b76b4b86d58741:0x589171fbc51c98e1,1,,,"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Leave a Google review (opens in new tab)"
              >
                Leave a Review
              </a>
            </li>
          </ul>

          <div class="footer__cta">
            <a href="/booking" class="btn btn--primary btn--sm">Book a Tour</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">
        &copy; {currentYear} Lower Notley Hall Farm, LLC. All rights reserved.
      </p>
      <p class="footer__legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <span aria-hidden="true"> &middot; </span>
        <a
          href="https://www.visitstmarysmd.com/contact-us/smcfwva-incident-reporting/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Report an Incident
        </a>
      </p>
      <p class="footer__credits">
        Website by <a href="https://kaylapratt.com" target="_blank" rel="noopener noreferrer">Kayla Pratt</a>
        &nbsp;·&nbsp;
        Photography by <a href="https://candacenicolephotography.com" target="_blank" rel="noopener noreferrer">Candace Nicole Photography</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary-dark);
    color: rgba(255,255,255,0.85);
    margin-top: auto;
  }

  /* Map band */
  .footer__map-band {
    display: grid;
  }

  .footer__map-wrap {
    height: 320px;
    overflow: hidden;
  }

  .footer__map-wrap iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Contact grid */
  .footer__contact-info {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
  }

  .footer__contact-grid {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }

  .footer__heading {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-accent-light);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  address {
    font-style: normal;
    line-height: var(--leading-relaxed);
  }

  address a,
  .footer__link-list a {
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  address a:hover,
  .footer__link-list a:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
  }

  .footer__link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__cta {
    margin-top: var(--space-6);
  }

  /* Bottom bar */
  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-block: var(--space-6);
  }

  .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.55);
  }

  .footer__bottom-inner a {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
  }

  .footer__bottom-inner a:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (min-width: 768px) {
    .footer__contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer__bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    .footer__map-band {
      grid-template-columns: 1fr 1fr;
    }

    .footer__map-wrap {
      height: auto;
      min-height: 400px;
    }
  }
</style>
