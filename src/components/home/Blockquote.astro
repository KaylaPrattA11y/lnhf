---
// Blockquote.astro
import { Image } from 'astro:assets';
import aerialLnhf from '../../assets/images/aerial-lnhf.jpg';
---

<section class="blockquote-section section section--dark" aria-label="About the venue">
  <div class="hero-img-wrapper">
    <Image
      src={aerialLnhf}
      alt="Aerial view of the reception barn at Lower Notley Hall Farm, next to the Wicomico River and surrounded by lush greenery."
      width="1400"
      height="933"
      loading="eager"
    />
  </div>
  <div class="container">
    <blockquote class="venue-quote">
      <p class="venue-quote__text">
        &ldquo;Standing aside the banks of the serene Wicomico River, you may enjoy cool river
        breezes and unimaginable sunsets with gulls, heron and osprey.
        An eagle sighting is not uncommon.&rdquo;
      </p>
      <footer class="venue-quote__footer">
        <hr class="divider" aria-hidden="true" />
        <cite>Lower Notley Hall Farm</cite>
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .hero-img-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    block-size: 100%;
    inline-size: 100%;
  }
  .hero-img-wrapper img {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.2;
  }

  .blockquote-section {
    background-color: var(--color-river-deep);
    position: relative;
    overflow: hidden;
  }

  .blockquote-section > .container {
    position: relative;
    z-index: 1;
  }

  .venue-quote {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    border: none;
    padding: 0;
  }

  .venue-quote__text {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: rgba(245, 240, 232, 0.90);
    margin-bottom: var(--space-8);
  }

  .venue-quote__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .venue-quote__footer cite {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
</style>
