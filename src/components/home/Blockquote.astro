---
// Blockquote.astro
---

<section class="blockquote-section section section--dark" aria-label="About the venue">
  <div class="container">
    <blockquote class="venue-quote">
      <p class="venue-quote__text">
        &ldquo;Standing aside the banks of the serene Wicomico River, you may enjoy cool river
        breezes and unimaginable sunsets with gulls, heron and osprey.
        An eagle sighting is not uncommon.&rdquo;
      </p>
      <footer class="venue-quote__footer">
        <hr class="divider" aria-hidden="true" />
        <cite>Lower Notley Hall Farm</cite>
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .blockquote-section {
    background-color: var(--color-river-deep);
    position: relative;
    overflow: hidden;
  }

  /* PHOTO PLACEHOLDER
   * Replace with a moody river/sunset photo:
   *   url('/images/blockquote-bg.jpg') center/cover fixed
   */
  .blockquote-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1400&q=60')
      center/cover;
    opacity: 0.18;
    pointer-events: none;
  }

  .blockquote-section > .container {
    position: relative;
    z-index: 1;
  }

  .venue-quote {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    border: none;
    padding: 0;
  }

  .venue-quote__text {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: rgba(245, 240, 232, 0.90);
    margin-bottom: var(--space-8);
  }

  .venue-quote__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .venue-quote__footer cite {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
</style>
