---
// Blockquote.astro
---

<section class="blockquote-section section section--dark" aria-label="About the venue">
  <div class="container">
    <blockquote class="venue-quote">
      <p class="venue-quote__text">
        &ldquo;Step back in time&hellip; to a place where the past meets the present
        and your future begins. Imagine string quartets, or fiddles firing up bluegrass
        on the covered porch — sunsets more intoxicating than champagne or fine wine.&rdquo;
      </p>
      <footer class="venue-quote__footer">
        <hr class="divider" aria-hidden="true" />
        <cite>Lower Notley Hall Farm</cite>
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .blockquote-section {
    background:
      linear-gradient(
        rgba(26,53,120,0.88),
        rgba(26,53,120,0.88)
      ),
      /*
       * PHOTO PLACEHOLDER
       * Replace with a moody river/sunset photo:
       *   url('/images/blockquote-bg.jpg') center/cover fixed
       */
      linear-gradient(135deg, #1a3578, #254aaf, #1a3050);
    background-attachment: fixed;
    background-size: cover;
  }

  .venue-quote {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
    border: none;
    padding: 0;
  }

  .venue-quote__text {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-style: italic;
    line-height: var(--leading-relaxed);
    color: var(--color-white);
    margin-bottom: var(--space-8);
    max-width: 100%;
  }

  .venue-quote__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .venue-quote__footer cite {
    font-style: normal;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-light);
  }
</style>
