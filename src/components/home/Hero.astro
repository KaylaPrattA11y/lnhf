---
// Hero.astro
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import receptionBarnInteriorRiverside from '../../assets/images/reception-barn-interior-riverside.jpg';
import aerialReceptionBarn from '../../assets/images/aerial-reception-barn.jpg';

interface HeroSlide {
  image: string;
  title: string;
  caption: string;
}

const heroSlides: HeroSlide[] = (await getCollection('carousel'))
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99))
  .slice(0, 5)
  .map((slide) => ({
    image: slide.data.image,
    caption: slide.data.caption,
    title: slide.data.title,
  }));

if (heroSlides.length === 0) {
  heroSlides.push({
    image: aerialReceptionBarn.src,
    title: 'Reception barn aerial view',
    caption: 'Aerial view of the reception barn at Lower Notley Hall Farm, next to the Wicomico River and surrounded by lush greenery.',
  });
}

---

<section class="hero" aria-label="Welcome to Lower Notley Hall Farm">

  <!-- LEFT — dark photo panel -->
  <div class="hero__left">
    <div class="hero__left-bg">
      <div
        class="hero-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Homepage photo slideshow"
        data-hero-carousel
      >
        <div class="hero-carousel__slides">
          {heroSlides.map((slide, index) => (
            <div
              class="hero-carousel__slide"
              data-slide
              data-active={index === 0 ? 'true' : 'false'}
              aria-roledescription="slide"
              aria-label={`Slide ${index + 1} of ${heroSlides.length}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <img src={slide.image} alt={slide.caption} loading={index === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>

        {heroSlides.length > 1 && (
          <div class="hero-carousel__dots" role="group" aria-label="Choose slide">
            {heroSlides.map((slide, index) => (
              <button
                class="hero-carousel__dot"
                type="button"
                data-dot
                data-index={index}
                aria-label={`Show slide ${index + 1}${slide.title ? `: ${slide.title}` : ''}`}
                aria-current={index === 0 ? 'true' : 'false'}
              >
                <span class="sr-only">Slide {index + 1}</span>
              </button>
            ))}
          </div>
        )}
      </div>
    </div>
    <div class="hero__left-content">
      <p class="hero__eyebrow">Chaptico, Maryland · On the Wicomico River</p>
      <h1 class="hero__title">Where time<br>stands <em>still</em></h1>
      <p class="hero__subtitle">
        Sunsets more intoxicating than champagne. River breezes through ancient oaks.
        A place where your story becomes the one people talk about for years.
      </p>
      <div class="hero__ctas">
        <a href="/tours/" class="btn btn--primary btn--lg">Book a Tour</a>
        <a href="/about/"   class="btn btn--outline-white btn--lg">Explore the Farm</a>
      </div>
    </div>
  </div>

  <!-- RIGHT — cream stats panel -->
  <div class="hero__right">
    <div class="hero-img-wrapper">
      <Image
        src={receptionBarnInteriorRiverside}
        alt="Interior view of the reception barn at Lower Notley Hall Farm, with riverside views and elegant decor."
        width="1400"
        height="933"
        loading="eager"
      />
    </div>
    <div class="hero__stat-grid">
      <div class="hero__stat">
        <span class="hero__stat-number">50</span>
        <span class="hero__stat-label">Miles south of Washington, DC</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-number">~150</span>
        <span class="hero__stat-label">Guest capacity</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-number">1</span>
        <span class="hero__stat-label">Wedding at a time — yours</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-number">★ 5</span>
        <span class="hero__stat-label">Stars across 30+ reviews</span>
      </div>
    </div>

    <div class="hero__location">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
        <circle cx="12" cy="9" r="2.5"/>
      </svg>
      <div>
        <strong>36290 Notley Manor Lane, Chaptico MD</strong>
        15 miles west of Leonardtown · (301) 769-2030
      </div>
    </div>
  </div>

</section>

<script>
  const carousels = document.querySelectorAll('[data-hero-carousel]');

  carousels.forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('[data-dot]');
    let currentIndex = 0;
    let autoplayId: ReturnType<typeof setInterval> | null = null;

    if (!slides.length || dots.length <= 1) {
      return;
    }

    const setSlide = (nextIndex: number) => {
      currentIndex = nextIndex;

      slides.forEach((slide, index) => {
        const isActive = index === nextIndex;
        slide.setAttribute('data-active', isActive ? 'true' : 'false');
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      dots.forEach((dot, index) => {
        dot.setAttribute('aria-current', index === nextIndex ? 'true' : 'false');
      });
    };

    const startAutoplay = () => {
      if (autoplayId) {
        clearInterval(autoplayId);
      }

      autoplayId = setInterval(() => {
        const nextIndex = currentIndex === slides.length - 1 ? 0 : currentIndex + 1;
        setSlide(nextIndex);
      }, 5000);
    };

    const handleManualSlide = (nextIndex: number) => {
      setSlide(nextIndex);
      startAutoplay();
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => handleManualSlide(index));

      dot.addEventListener('keydown', (event) => {
        const keyEvent = event as KeyboardEvent;
        const last = dots.length - 1;
        let next = index;

        if (keyEvent.key === 'ArrowRight') {
          next = index === last ? 0 : index + 1;
        } else if (keyEvent.key === 'ArrowLeft') {
          next = index === 0 ? last : index - 1;
        } else if (keyEvent.key === 'Home') {
          next = 0;
        } else if (keyEvent.key === 'End') {
          next = last;
        } else {
          return;
        }

        event.preventDefault();
        handleManualSlide(next);
        dots[next].focus();
      });
    });

    startAutoplay();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    min-height: calc(100vh - var(--nav-height));
  }

  :is(.hero__left, .hero__right) {
    @container main (width >= 600px) {
      display: flex;
      align-items: center;
      padding: 5rem 3rem 5rem;
    }
  }

  /* ── Left panel — dark photo ──────────────────────── */
  .hero__left {
    background-color: var(--color-bark);
    position: relative;
    overflow: hidden;
    min-height: 68vh;
  }

  .hero__left::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 35, 42, 0.12) 15%, rgba(17, 35, 42, 0.62) 82%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-img-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    block-size: 100%;
    inline-size: 100%;
  }

  .hero-carousel {
    position: absolute;
    inset: 0;
  }

  .hero-carousel__slides {
    position: absolute;
    inset: 0;
  }

  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    scale: 1;
    transition: scale 5s linear, opacity 350ms ease;
  }

  .hero-carousel__slide[data-active='true'] {
    opacity: 1;
    scale: 1.035;
  }

  .hero-carousel__slide img {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-carousel__dots {
    position: absolute;
    inset-inline: 0;
    bottom: 1rem;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.7rem;
  }

  .hero-carousel__dot {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition: transform 120ms ease, background-color 120ms ease;
  }

  .hero-carousel__dot[aria-current='true'] {
    background: var(--color-gold-light);
    border-color: var(--color-gold-light);
    transform: scale(1.06);
  }

  .hero-carousel__dot:hover {
    background: rgba(255, 255, 255, 0.45);
  }

  .hero-carousel__dot:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 2px;
  }

  .hero__left {
    padding: 0.5rem 0.5rem 2.5rem 0.5rem;
  }

  .hero__left-content {
    position: relative;
    z-index: 2;
    animation: fadeUp 0.9s ease 0.2s both;
    background: rgba(45, 85, 99, 0.3);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    padding: 2rem 1rem;
    border-radius: var(--space-5);
    corner-shape: scoop;
    border: 5px double rgba(255, 255, 255, 0.18);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: var(--text-hero);
    line-height: 1.05;
    color: var(--color-cream);
    margin-bottom: 1.5rem;
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-gold-light);
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.92rem;
    line-height: 1.85;
    color: white;
    max-width: 400px;
    margin-bottom: 2.4rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* ── Right panel — cream stats ────────────────────── */
  .hero__right {
    background-color: var(--color-cream);
    flex-direction: column;
    justify-content: center;
    
    position: relative;
  }

  .hero__right .hero-img-wrapper img {
    opacity: 0.15;
  }

  .hero__stat-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
    animation: fadeUp 0.9s ease 0.3s both;
    @container main (width < 600px) {
      padding: 1rem;
    }
  }

  .hero__stat {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-mist);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hero__stat-number {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 2.8rem;
    color: var(--color-gold);
    line-height: 1;
  }

  .hero__stat-label {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__location {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-warm-white);
    border-left: 2px solid var(--color-gold);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    animation: fadeUp 0.9s ease 0.45s both;
  }

  .hero__location svg { color: var(--color-gold); flex-shrink: 0; margin-top: 2px; }

  .hero__location strong {
    display: block;
    color: var(--color-bark);
    font-weight: 500;
    font-size: 0.88rem;
    margin-bottom: 2px;
  }

  /* ── Animation ────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 2fr 1fr;
      min-height: calc(100vh - 12rem);
    }

    .hero__left {
      min-height: unset;
      padding: 7rem 4rem 6rem 5rem;
    }

    .hero__left-content {
      max-width: 40rem;
      padding: 2.4rem;
      background: rgba(22, 44, 52, 0.38);
      border: 1px solid rgba(255, 255, 255, 0.24);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    .hero__right {
      padding: 6rem 4rem 6rem 5rem;
    }
  }

  @media (min-width: 1200px) {
    .hero__left  { padding: 7rem 5rem 7rem 6rem; }
    .hero__right { padding: 6rem 5rem 6rem 6rem; }
  }
</style>
