---
// TourForm.astro — inline private tour request form (Netlify Forms)
---

<section class="tour-form-section section bg-arabesque" aria-labelledby="tour-form-title">
  <div class="container tour-form-container">
    <div class="section-header">
      <span class="section-header__eyebrow">Come Visit Us</span>
      <h2 class="section-header__title" id="tour-form-title">Book a Private Tour</h2>
      <hr class="divider" aria-hidden="true" />
      <p class="section-header__subtitle">
        Tours are held on Sundays. Each tour lasts approximately one hour.
        We ask that you give us 48 hours notice to cancel.
      </p>
    </div>

    <form
      name="tour-inquiry"
      method="POST"
      action="/contact/success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="tour-form"
      novalidate
      aria-label="Private tour request form"
      id="tour-inquiry-form"
    >
      <!-- Netlify honeypot -->
      <div class="bot-field" aria-hidden="true">
        <label>Do not fill this field: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </div>

      <input type="hidden" name="form-name" value="tour-inquiry" />

      <div class="tour-form__grid">
        <div class="form-group">
          <label class="form-label" for="tour-name">
            Full Name <span class="required" aria-hidden="true">*</span>
          </label>
          <input
            class="form-input"
            type="text"
            id="tour-name"
            name="name"
            required
            autocomplete="name"
            aria-required="true"
            placeholder="Your full name"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="tour-email">
            Email Address <span class="required" aria-hidden="true">*</span>
          </label>
          <input
            class="form-input"
            type="email"
            id="tour-email"
            name="email"
            required
            autocomplete="email"
            aria-required="true"
            placeholder="your@email.com"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="tour-phone">Phone Number</label>
          <input
            class="form-input"
            type="tel"
            id="tour-phone"
            name="phone"
            autocomplete="tel"
            placeholder="(301) 555-0100"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="tour-date">Preferred Tour Date</label>
          <input
            class="form-input"
            type="date"
            id="tour-date"
            name="preferred-date"
            min={new Date().toISOString().split('T')[0]}
          />
        </div>

        <div class="form-group tour-form__full">
          <label class="form-label" for="tour-message">Message or Questions</label>
          <textarea
            class="form-textarea"
            id="tour-message"
            name="message"
            rows="4"
            maxlength="1000"
            placeholder="Tell us a bit about your vision or ask any questions…"
          ></textarea>
        </div>
      </div>

      <div class="tour-form__submit">
        <button type="submit" class="btn btn--primary btn--lg">
          Request a Tour
        </button>
        <p class="tour-form__note">
          Prefer to call? <a href="tel:3017692030">(301) 769-2030</a>
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .tour-form-container {
    max-width: 860px;
  }

  .tour-form__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-8);
  }

  .tour-form__full {
    grid-column: 1 / -1;
  }

  .tour-form__submit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .tour-form__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (min-width: 640px) {
    .tour-form__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
