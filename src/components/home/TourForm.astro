---
// TourForm.astro — inline private tour request form (Netlify Forms)
---

<section class="tour-form-section section bg-arabesque" aria-labelledby="tour-form-title">
  <div class="container tour-form-container">
    <div class="section-header">
      <span class="section-header__eyebrow">Come Visit Us</span>
      <h2 class="section-header__title" id="tour-form-title">Book a Private Tour</h2>
      <hr class="divider" aria-hidden="true" />
      <p class="section-header__subtitle">
        Tours are held on Sundays. Each tour lasts approximately one hour.
        We ask that you give us 48 hours notice to cancel.
      </p>
      <a href="/tours/" class="btn btn--primary btn--lg">
        Request a Tour
      </a>
    </div>
  </div>
</section>

<style>
  .tour-form-container {
    max-width: 860px;
  }

  .tour-form__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-8);
  }

  .tour-form__full {
    grid-column: 1 / -1;
  }

  .tour-form__submit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .tour-form__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  p {
    margin-bottom: 1em;
  }

  @media (min-width: 640px) {
    .tour-form__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
