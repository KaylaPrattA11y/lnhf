---
// TheSetting.astro
import USP from '@data/usp';
import VISTAS from '@data/vistas';
import VENUE from '@data/venue';

const spaces = [
  {
    name: VISTAS.HOUSE.NAME,
    description: VISTAS.HOUSE.DESC.HOME,
    photo: VISTAS.HOUSE.IMG.src,
    link: '/offerings#19th-century-victorian-manor-house',
  },
  {
    name: VISTAS.BARN.NAME,
    description: VISTAS.BARN.DESC.HOME,
    photo: VISTAS.BARN.IMG.src,
    link: '/offerings#cocktail-hour-barn-deck',
  },
  {
    name: VISTAS.WATERFRONT.NAME,
    description: VISTAS.WATERFRONT.DESC.HOME,
    photo: VISTAS.WATERFRONT.IMG.src,
    link: '/offerings#stunning-waterfront',
  },
];
---

<section class="setting section bg-arabesque" aria-labelledby="setting-title">
  <div class="container">
    <div class="section-header">
      <span class="section-header__eyebrow">The Venue</span>
      <h2 class="section-header__title" id="setting-title">The Setting</h2>
      <hr class="divider" aria-hidden="true" />
      <p class="section-header__subtitle">
        {VENUE.NAME} is an award-winning, family-owned historic waterfront wedding venue located in Southern Maryland just {USP.DC_DISTANCE_MILES.VALUE} {USP.DC_DISTANCE_MILES.UNIT} {USP.DC_DISTANCE_MILES.DESC}.
      </p>
    </div>

    <div class="setting__grid">
      {spaces.map((space) => (
        <article class="setting__card card">
          <img
            class="setting__card-icon"
            src={space.photo}
            alt=""
            loading="lazy"
            width="960"
            height="640"
          />
          <div class="card__body">
            <h3 class="setting__card-title">{space.name}</h3>
            <p>{space.description}</p>
            <a href={space.link} class="btn btn--primary">
              Learn more <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="setting__cta">
      <a href="/offerings/" class="btn btn--secondary">Explore What We Offer</a>
    </div>
  </div>
</section>

<style>
  .setting__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-12);
  }

  .setting__card {
    text-align: center;
  }

  .setting__card-icon {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-mist);
  }

  .setting__card-title {
    font-size: var(--text-2xl);
    font-weight: 300;
    color: var(--color-bark);
    margin-bottom: var(--space-3);
  }

  .setting__card-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 400;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-gold);
    text-decoration: none;
  }

  .setting__card-link:hover {
    color: var(--color-gold-dark);
  }

  .setting__cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .setting__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
