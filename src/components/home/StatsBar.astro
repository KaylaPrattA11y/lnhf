---
// StatsBar.astro
const stats = [
  { value: '50 miles', label: 'South of Washington, DC' },
  { value: 'Up to 150', label: 'Guests Accommodated' },
  { value: 'Top 3', label: 'Southern MD Venue — BusinessRate 2026 ★' },
];
---

<div class="stats-bar bg-quatrefoils" aria-label="Venue highlights">
  <div class="stats-bar__inner container">
    {stats.map((stat) => (
      <div class="stats-bar__item">
        <span class="stats-bar__value">{stat.value}</span>
        <span class="stats-bar__label">{stat.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .stats-bar {
    border-top: 1px solid rgba(181, 146, 76, 0.20);
    border-bottom: 1px solid rgba(181, 146, 76, 0.20);
  }

  .stats-bar__inner {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
    padding-block: var(--space-8);
    gap: var(--space-6);
  }

  .stats-bar__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-4);
  }

  .stats-bar__value {
    font-family: var(--font-heading);
    font-weight: 300;
    font-style: italic;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-gold);
  }

  .stats-bar__label {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.60);
  }

  @media (min-width: 640px) {
    .stats-bar__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .stats-bar__item {
      border-right: 1px solid rgba(255,255,255,0.08);
    }

    .stats-bar__item:last-child {
      border-right: none;
    }
  }
</style>
