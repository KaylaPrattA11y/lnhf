---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import receptionBarnInteriorRiverside from '@assets/images/reception-barn-interior-riverside.jpg';
import type { CarouselQuery } from '../../../tina/__generated__/types';

interface Props {
  slides: Array<CarouselQuery['carousel']>;
  selectedRelativePath?: string;
}

const { slides, selectedRelativePath = '' } = Astro.props;

type SlideEntry = NonNullable<CarouselQuery['carousel']>;

const items = slides
  .filter((slide): slide is SlideEntry => Boolean(slide))
  .sort((left, right) => (left.sortOrder ?? 99) - (right.sortOrder ?? 99));

const normalizePath = (value: string) => {
  try {
    return decodeURIComponent(value).trim().toLowerCase();
  } catch {
    return value.trim().toLowerCase();
  }
};

const normalizedSelectedPath = normalizePath(selectedRelativePath);

const fieldAttr = (slide: SlideEntry, field: 'image' | 'title' | 'caption' | 'sortOrder') => {
  const value = tinaField(slide, field);
  return value || undefined;
};

const imageSrc = (slide: SlideEntry): string => {
  const raw = (slide as { image?: unknown }).image;
  if (typeof raw === 'string') return raw;
  if (raw && typeof raw === 'object') {
    const maybe = raw as { src?: unknown; url?: unknown; path?: unknown };
    if (typeof maybe.src === 'string') return maybe.src;
    if (typeof maybe.url === 'string') return maybe.url;
    if (typeof maybe.path === 'string') return maybe.path;
  }
  return '';
};
---

{items.length > 0 && (
  <section class="section bg-arabesque" aria-labelledby="carousel-preview-title">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">Homepage Slider</span>
        <h2 class="section-header__title" id="carousel-preview-title">Homepage Slider Preview (Visual Editor)</h2>
        <hr class="divider" aria-hidden="true" />
        <p class="section-header__subtitle">Each slide below shows the full hero section as it appears on the homepage. Click a slide's photo to open its editor form.</p>
      </div>
    </div>

    <div class="hero-stack">
      {items.map((slide, index) => {
        const isSelected = normalizedSelectedPath
          ? (slide._sys?.relativePath?.trim().toLowerCase() ?? '') === normalizedSelectedPath
          : index === 0;

        return (
          <div class={`hero-stack__item${isSelected ? ' hero-stack__item--selected' : ''}`}>
            <div class="hero">
              <div class="hero__left">
                <div class="hero-img-wrapper hero__image" data-tina-field={fieldAttr(slide, 'image')}>
                  {imageSrc(slide)
                    ? <img src={imageSrc(slide)} alt={slide.caption ?? slide.title ?? `Slide ${index + 1}`} loading="lazy" />
                    : <div class="slide-thumb-placeholder">No image</div>}
                </div>
                <div class="hero__left-content">
                  <p class="hero__eyebrow">Chaptico, Maryland · On the Wicomico River</p>
                  <h3 class="hero__title">Where time<br />stands <em>still</em></h3>
                  <p class="hero__subtitle">Sunsets more intoxicating than champagne. River breezes through ancient oaks. A place where your story becomes the one people talk about for years.</p>
                  <div class="hero__ctas">
                    <span class="btn btn--primary btn--lg">Book a Tour</span>
                    <span class="btn btn--outline-white btn--lg">Explore the Farm</span>
                  </div>
                </div>
              </div>

              <div class="hero__right">
                <div class="hero-img-wrapper">
                  <Image
                    src={receptionBarnInteriorRiverside}
                    alt="Interior view of the reception barn at Lower Notley Hall Farm, with riverside views and elegant decor."
                    width="1400"
                    height="933"
                    loading="lazy"
                  />
                </div>
                <div class="hero__stat-grid">
                  <div class="hero__stat">
                    <span class="hero__stat-number">50</span>
                    <span class="hero__stat-label">Miles south of Washington, DC</span>
                  </div>
                  <div class="hero__stat">
                    <span class="hero__stat-number">~150</span>
                    <span class="hero__stat-label">Guest capacity</span>
                  </div>
                  <div class="hero__stat">
                    <span class="hero__stat-number">1</span>
                    <span class="hero__stat-label">Wedding at a time — yours</span>
                  </div>
                  <div class="hero__stat">
                    <span class="hero__stat-number">★ 5</span>
                    <span class="hero__stat-label">Stars across 30+ reviews</span>
                  </div>
                </div>
                <div class="hero__location">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                  </svg>
                  <div>
                    <strong>36290 Notley Manor Lane, Chaptico MD</strong>
                    15 miles west of Leonardtown · (301) 769-2030
                  </div>
                </div>
              </div>
            </div>

            <div class="hero-stack__meta">
              <strong class="hero-stack__title" data-tina-field={fieldAttr(slide, 'title')}>
                {slide.title ?? `Slide ${index + 1}`}
              </strong>
              <span class="hero-stack__caption" data-tina-field={fieldAttr(slide, 'caption')}>
                {slide.caption ?? 'No caption provided'}
              </span>
              <span class="hero-stack__order" data-tina-field={fieldAttr(slide, 'sortOrder')}>
                Sort order: {slide.sortOrder ?? 99}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

<style>
  .hero-stack {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .hero-stack__item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .hero-stack__item--selected {
    outline: 2px dashed var(--color-accent);
    outline-offset: 3px;
  }

  .hero-stack__meta {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
    background: var(--color-white);
  }

  .hero-stack__title {
    color: var(--color-primary-dark);
    font-size: 0.95rem;
  }

  .hero-stack__caption {
    color: var(--color-text);
    font-size: 0.82rem;
  }

  .hero-stack__order {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .slide-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-cream);
  }

  /* ── Hero replica (mirrors src/components/home/Hero.astro) ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    min-height: min(70vh, 40rem);
  }

  .hero__left,
  .hero__right {
    display: flex;
    align-items: center;
    padding: 2.5rem 1.5rem;
  }

  .hero__left {
    background-color: var(--color-bark);
    position: relative;
    overflow: hidden;
  }

  .hero__left::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 35, 42, 0.12) 15%, rgba(17, 35, 42, 0.62) 82%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-img-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    block-size: 100%;
    inline-size: 100%;
  }

  .hero-img-wrapper img {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__left-content {
    position: relative;
    z-index: 2;
    background: rgba(45, 85, 99, 0.3);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    padding: 2rem 1.5rem;
    border-radius: var(--space-5);
    border: 5px double rgba(255, 255, 255, 0.18);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    max-width: 32rem;
  }

  .hero__eyebrow {
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin: 0 0 1.5rem;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    color: var(--color-cream);
    margin: 0 0 1.5rem;
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-gold-light);
  }

  .hero__subtitle {
    font-weight: 300;
    font-size: 0.92rem;
    line-height: 1.85;
    color: white;
    max-width: 400px;
    margin: 0 0 2rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__right {
    background-color: var(--color-cream);
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .hero__right .hero-img-wrapper img {
    opacity: 0.15;
  }

  .hero__stat-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .hero__stat {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-mist);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hero__stat-number {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 2.4rem;
    color: var(--color-gold);
    line-height: 1;
  }

  .hero__stat-label {
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__location {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-warm-white);
    border-left: 2px solid var(--color-gold);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .hero__location svg {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hero__location strong {
    display: block;
    color: var(--color-bark);
    font-weight: 500;
    font-size: 0.88rem;
    margin-bottom: 2px;
  }

  .hero__image {
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 2fr 1fr;
    }

    .hero__left {
      padding: 4rem 3rem;
    }
  }
</style>