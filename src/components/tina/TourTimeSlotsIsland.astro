---
import { tinaField } from '@tinacms/astro/tina-field';
import type { TourTimeSlotsQuery } from '../../../tina/__generated__/types';
import { fmtTwelveHourTime } from '@lib/formatters';

interface TourSlot {
  tourStart: string;
  tourEnd: string;
  seedSlotOnDay?: string[];
}

interface Props {
  timeSlotOptions: Array<TourTimeSlotsQuery['tourTimeSlots']>;
}

const { timeSlotOptions } = Astro.props;

type TourSlotEntry = NonNullable<TourTimeSlotsQuery['tourTimeSlots']>;

const weekdayLabels: Record<string, string> = {
  '0': 'Sunday',
  '1': 'Monday',
  '2': 'Tuesday',
  '3': 'Wednesday',
  '4': 'Thursday',
  '5': 'Friday',
  '6': 'Saturday',
};

const slots = timeSlotOptions
  .filter((slot): slot is TourSlotEntry => Boolean(slot?.tourStart) && Boolean(slot?.tourEnd))
  .sort((left, right) => left.tourStart.localeCompare(right.tourStart));

const formatSeedDays = (seedDays?: string[] | null) => {
  if (!seedDays || seedDays.length === 0) return 'Manual only';
  return seedDays.map((day) => weekdayLabels[day] ?? day).join(', ');
};

const getTourDuration = (start: string, end: string) => {
  const startDate = new Date(`1970-01-01T${start}`);
  const endDate = new Date(`1970-01-01T${end}`);
  const durationMs = endDate.getTime() - startDate.getTime();
  const durationMinutes = Math.floor(durationMs / (1000 * 60));
  const hours = Math.floor(durationMinutes / 60);
  const minutes = durationMinutes % 60;
  return `${hours}h ${minutes}m`;
};
---

<section class="section bg-arabesque booking-calendar-section" aria-label="Tour calendar">
  <div class="container booking-calendar-wrap">
    <div class="section-header">
      <h2 class="section-header__title" id="carousel-preview-title">Tour Time Slots (Visual Editor)</h2>
      <p class="section-header__subtitle">Each entry below represents a tour time slot. Your guests will see these options when clicking on a calendar day of the week to book a tour.</p>
    </div>
    <ul class="tour-slot-list">
      {slots.map((slot, index) => (
        <li class="tour-slot-item">
          <h3>Tour Slot {index + 1}</h3>
          <div class="tour-slot-field" >
            <span data-tina-field={tinaField(slot, 'tourStart')}>{fmtTwelveHourTime(slot.tourStart)}</span>—
            <span data-tina-field={tinaField(slot, 'tourEnd')}>{fmtTwelveHourTime(slot.tourEnd)}</span>&nbsp;
            (<span>{getTourDuration(slot.tourStart, slot.tourEnd)}</span>)
          </div>
          <div class="tour-slot-field" data-tina-field={tinaField(slot, 'seedSlotOnDay')}>
            <span class="tour-slot-label">Seed On</span>:&nbsp;
            <span>{formatSeedDays(slot.seedSlotOnDay as string[] | undefined)}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tour-slot-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tour-slot-item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    color: var(--color-primary-dark);
    display: grid;
    gap: var(--space-2);
  }

  .tour-slot-field {
    cursor: pointer;
  }

</style>
