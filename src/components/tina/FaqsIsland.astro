---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { FaqsQuery } from '../../../tina/__generated__/types';

interface Props {
  entries: Array<FaqsQuery['faqs']>;
  inEditMode?: boolean;
}

const { entries, inEditMode = false } = Astro.props;
---

<section class="section bg-arabesque" aria-label="FAQ accordion">
  <div class="container faqs-container">
    <div class="faq-list" role="list">
      {entries.map((faq) => {
        if (!faq) return null;
        return (
          <details class="faq-item" open={inEditMode}>
            <summary class="faq-item__summary">
              <h2 class="faq-item__heading" data-tina-field={tinaField(faq, 'question')}>
                {faq.question}
              </h2>
            </summary>
            <div class="faq-item__panel">
              <div class="faq-item__answer" data-tina-field={tinaField(faq, 'body')}>
                {faq.body && <TinaMarkdown content={faq.body} />}
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <div class="faqs-footer-note">
      <p>
        <strong>Still have questions?</strong> <a href="/contact/">Contact Jack and Cindy</a> — we love
        talking about the farm and what we can do for you.
      </p>
    </div>
  </div>
</section>

<style>
  .container {
    @container (width < 600px) {
      --padding-x: 0;
    }
  }
  .faqs-container { max-width: 840px; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .faq-item {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item.is-open {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }
  .faq-item__heading { 
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0; 
    display: inline-block;
  }
  .faq-item__summary {
    padding: var(--space-5) var(--space-6);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background var(--transition-fast);
  }
  .faq-item__summary::marker {
    display: inline-block;
  }
  .faq-item__trigger:hover { background: var(--color-gray-100); }
  .faq-item.is-open .faq-item__trigger { background: var(--color-gray-100); }
  .faq-item__trigger:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }
  .faq-item__question {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-primary-dark);
    line-height: var(--leading-snug);
  }
  .faq-item__icon {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform var(--transition-base);
  }
  .faq-item.is-open .faq-item__icon { transform: rotate(180deg); }
  .faq-item__panel {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .faq-item__answer {
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  .faq-item__answer :global(p)  { max-inline-size: 80ch; margin-bottom: var(--space-3); }
  .faq-item__answer :global(a)  { color: var(--color-primary); font-weight: 700; }
  .faq-item__answer :global(ul), .faq-item__answer :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .faqs-footer-note {
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    text-align: center;
    font-size: var(--text-base);
  }
  .faqs-footer-note p:last-child {
    margin-bottom: 0;
  }
  .faqs-footer-note a { color: var(--color-primary); font-weight: 700; }
</style>
