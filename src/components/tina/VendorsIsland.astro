---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { VendorsQuery } from '../../../tina/__generated__/types';

interface Props {
  vendors: Array<VendorsQuery['vendors']>;
}

const { vendors } = Astro.props;

const serviceOrder = [
  'Bartending', 'Catering', 'Decor', 'DJs and Entertainment',
  'Florist', 'Photography', 'Transportation', 'Wedding Coordination', 'Other',
];
const serviceRank = new Map(serviceOrder.map((s, i) => [s, i]));

type VendorItem = NonNullable<VendorsQuery['vendors']>;

const grouped = vendors
  .filter((v): v is VendorItem => Boolean(v))
  .flatMap(v => {
    const services: string[] = Array.isArray(v.vendorServices) && v.vendorServices.length
      ? (v.vendorServices as string[])
      : ['Other'];
    return services.map(service => ({ service, vendor: v }));
  })
  .sort((a, b) => {
    const byCat = (serviceRank.get(a.service) ?? 999) - (serviceRank.get(b.service) ?? 999);
    if (byCat !== 0) return byCat;
    return (a.vendor.name ?? '').localeCompare(b.vendor.name ?? '');
  })
  .reduce<Record<string, VendorItem[]>>((acc, { service, vendor }) => {
    (acc[service] ??= []).push(vendor);
    return acc;
  }, {});
---

<section class="section bg-arabesque" aria-label="Vendor list">
  <div class="container vendors-container">
    {Object.entries(grouped).map(([category, items]) => (
      <div class="vendor-group">
        <h2 class="vendor-group__title">{category}</h2>
        <div class="vendor-cards">
          {items.map(v => (
            <article class="vendor-card">
              {v.logo ? (
                  <div class="vendor-card__logo">
                    <img src={v.logo} alt={`${v.name} logo`} data-tina-field={tinaField(v, 'logo')} />
                  </div>
                ) : null}
              <div class="vendor-card__content">
                <div class="vendor-card__header">
                  <div>
                    <h3 class="vendor-card__name" data-tina-field={tinaField(v, 'name')}>
                      {v.website ? (
                        <a href={v.website} target="_blank" rel="noopener noreferrer"
                          data-tina-field={tinaField(v, 'website')}>
                          {v.name}
                        </a>
                      ) : v.name}
                    </h3>
                  </div>
                </div>

                {v.email && (
                  <p class="vendor-card__desc">
                    <strong>Email:</strong>{' '}
                    <a href={`mailto:${v.email.trim()}`} data-tina-field={tinaField(v, 'email')}>
                      {v.email.trim()}
                    </a>
                  </p>
                )}
                {v.phone && (
                  <p class="vendor-card__desc">
                    <strong>Phone:</strong>{' '}
                    <a href={`tel:${v.phone.replace(/\D/g, '').trim()}`} data-tina-field={tinaField(v, 'phone')}>
                      {v.phone.trim()}
                    </a>
                  </p>
                )}
                {v.body && (
                  <div class="vendor-card__desc vendor-card__details" data-tina-field={tinaField(v, 'body')}>
                    <TinaMarkdown content={v.body} />
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .vendors-container { max-width: 900px; }

  .vendor-group { margin-bottom: var(--space-10); }
  .vendor-group__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }
  .vendor-cards {
    container: vendor-cards / inline-size;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    @container main (width < 600px) {
      width: calc(100% + var(--padding-x) * 2);
      margin-inline: calc(var(--padding-x) * -1) 0;
    }
  }
  @media (min-width: 640px) {
    .vendor-cards { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  }
  .vendor-card {
    container: vendor-card / inline-size;
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    min-block-size: 200px;
    display: grid;
    grid-template-columns: 1fr auto;
  }
  .vendor-card__content {
    padding: var(--space-6);
  }
  .vendor-card__logo {
    max-inline-size: 100px;
    overflow: hidden;
    order: 2;
    @container vendor-cards (width >= 400px) {
      max-inline-size: 150px;
    }
  }
  .vendor-card__logo img {
    max-inline-size: 100%;
    max-block-size: 100%;
    object-fit: contain;
  }
  .vendor-card__header {
    display: grid;
    gap: var(--space-1) var(--space-5);
    position: relative;
    z-index: 1;
    @container vendor-card (width >= 300px) {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    margin-block-end: var(--space-3);
  }
  .vendor-card--featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(226,161,32,0.2);
  }
  .vendor-card__badge {
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .vendor-card__name {
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
    margin: 0;
  }
  .vendor-card__name a { 
    color: var(--color-primary);
  }
  .vendor-card__name a:hover { color: var(--color-accent); }
  .vendor-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .vendor-card__details {
    position: relative;
    z-index: 1;
    margin-top: var(--space-3);
  }

  .vendor-card__details :global(p) {
    margin: 0 0 var(--space-2);
  }

  .vendor-card__details :global(p:last-child) {
    margin-bottom: 0;
  }

  .vendor-card__services {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .vendor-card__service-chip {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .vendor-card__service-chip--active {
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-accent) 20%, white);
    border-color: color-mix(in srgb, var(--color-accent) 60%, white);
    font-weight: 600;
  }

  .vendors-note {
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .vendors-note a { color: var(--color-primary); font-weight: 700; word-wrap: break-word; }
</style>
