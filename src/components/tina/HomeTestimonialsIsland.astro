---
import Testimonials from '@components/home/Testimonials';
import { tinaField } from '@tinacms/astro/tina-field';
import type { TestimonialsQuery } from '../../../tina/__generated__/types';

interface Props {
  testimonials: Array<TestimonialsQuery['testimonials'] | Record<string, unknown>>;
  inEditMode?: boolean;
  selectedRelativePath?: string;
}

const { testimonials, inEditMode = false, selectedRelativePath = '' } = Astro.props;

type TestimonialEntry = NonNullable<TestimonialsQuery['testimonials']>;

const items = testimonials
  .filter((testimonial): testimonial is TestimonialEntry => Boolean(testimonial))
  .sort((left, right) => (left.sortOrder ?? 99) - (right.sortOrder ?? 99));

const normalizePath = (value: string) => {
  try {
    return decodeURIComponent(value).trim().toLowerCase();
  } catch {
    return value.trim().toLowerCase();
  }
};

const normalizedSelectedPath = normalizePath(selectedRelativePath);

const selectedIndex = normalizedSelectedPath
  ? items.findIndex((item) => {
      const path = item._sys?.relativePath?.trim().toLowerCase() ?? '';
      return path === normalizedSelectedPath;
    })
  : -1;

const orderedItems = selectedIndex > 0
  ? [items[selectedIndex], ...items.slice(0, selectedIndex), ...items.slice(selectedIndex + 1)]
  : items;

const visibleItems = orderedItems
  .filter((item) => Boolean(item.testimonial && item.names));

const normalizedTestimonials = visibleItems
  .map((item) => ({
    testimonial: item.testimonial ?? '',
    names: item.names ?? '',
    photo: item.photo ?? undefined,
    date: item.date ?? undefined,
  }));

const testimonialFieldAttrs = visibleItems
  .map((item) => ({
    testimonial: tinaField(item, 'testimonial') || undefined,
    names: tinaField(item, 'names') || undefined,
    photo: tinaField(item, 'photo') || undefined,
    date: tinaField(item, 'date') || undefined,
  }));
---

{normalizedTestimonials.length > 0 && (
  inEditMode
    ? (
      <section class="testimonials bg-outline-circles" aria-label="Guest testimonials" aria-live="polite">
        <div class="testimonials__inner">
          <div class="testimonials__stack">
            {visibleItems.map((item, index) => {
              const fieldAttrs = testimonialFieldAttrs[index];
              const isSelected = normalizedSelectedPath
                ? (item._sys?.relativePath?.trim().toLowerCase() ?? '') === normalizedSelectedPath
                : index === 0;

              return (
                <div class={`testimonials__slide${isSelected ? ' testimonials__slide--selected' : ''}`}>
                  <blockquote class="testimonials__quote">
                    {item.photo && (
                      <img
                        data-tina-field={fieldAttrs?.photo}
                        src={item.photo}
                        alt={`Photo of ${(item.names ?? '').split(',')[0].trim()}${(item.names ?? '').includes(',') ? ' and others' : ''}, who provided a testimonial about their experience at Lower Notley Hall Farm.`}
                        class="testimonials__photo"
                        width="175"
                        height="125"
                      />
                    )}
                    <p class="testimonials__text" data-tina-field={fieldAttrs?.testimonial}>&ldquo;{item.testimonial}&rdquo;</p>
                    <footer class="testimonials__attribution">
                      <cite class="testimonials__author" data-tina-field={fieldAttrs?.names}>{item.names}</cite>
                      {item.date && <span class="testimonials__date" data-tina-field={fieldAttrs?.date}>{item.date}</span>}
                    </footer>
                  </blockquote>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
    : <Testimonials client:load testimonials={normalizedTestimonials} fieldAttrs={testimonialFieldAttrs} />
)}

<style>
  .testimonials {
    position: relative;
    padding-block: var(--space-20);
    @container main (width < 600px) {
      padding: 1rem;
    }
  }
  .testimonials__inner {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
    @container main (width < 600px) {
      padding-inline: 0;
    }
  }
  .testimonials__slide {
    container: testimonial / inline-size;
    background: rgb(38 28 16 / 90%);
    transition: opacity 0.3s ease;
    color: white;
    padding: var(--space-10) var(--space-5) var(--space-5) var(--space-5);
    border-radius: var(--space-5);
    corner-shape: bevel;
    backdrop-filter: blur(4px);
  }
  .testimonials__stack {
    display: grid;
    gap: var(--space-6);
  }
  .testimonials__slide--selected {
    outline: 2px dashed var(--color-accent);
    outline-offset: 3px;
  }
  .testimonials__quote {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-8);
  }
  .testimonials__quote img {
  margin: var(--space-2) auto;
  corner-shape: scoop;
  border-radius: 10px;
  @container testimonial (width >= 300px) {
      margin: var(--space-2) var(--space-2) var(--space-2) 0;
      float: left;
      clear: both;
    }
  }
  .testimonials__text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: var(--color-white);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 100%;
  }
  .testimonials__attribution {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .testimonials__attribution::before {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .testimonials__author {
    font-style: normal;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-accent-light);
    font-weight: 600;
  }
  .testimonials__date {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.05em;
  }
</style>
