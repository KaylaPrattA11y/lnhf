---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';

const { title, description, date, author, featuredImage, ogImage } = Astro.props;
const resolvedOgImage =
  (typeof ogImage === 'string' ? ogImage : undefined) ??
  (typeof featuredImage === 'string' ? featuredImage : featuredImage?.src);
---

<BaseLayout 
  title={title} 
  description={description} 
  ogImage={resolvedOgImage}
>
  <Nav slot="nav" />

  {featuredImage && (
    <div class="parallax" aria-hidden="true" style={`background-image: url('${featuredImage}');`}>
      <header class="blog-post__header">
        <div class="container">
          <h1 class="blog-post__title">{title}</h1>
          {(date || author) && (
            <p class="blog-post__meta">
              {date && (
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
              {date && author && <span aria-hidden="true"> · </span>}
              {author && <span>By {author}</span>}
            </p>
          )}
        </div>
      </header>
    </div>
  )}

  <article class="bg-arabesque">
    <div class="blog-post container">
      {!featuredImage && (
        <header class="blog-post__header">
          <h1 class="blog-post__title">{title}</h1>
          {(date || author) && (
            <p class="blog-post__meta">
              {date && (
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
              {date && author && <span aria-hidden="true"> · </span>}
              {author && <span>By {author}</span>}
            </p>
          )}
          <hr class="divider divider--left" aria-hidden="true" />
        </header>
      )}
  
      <div class="blog-post__body prose">
        <slot />
      </div>
  
      <footer class="blog-post__footer">
        <a href="/blog/" class="btn btn--secondary btn--sm">&larr; Back to Blog</a>
      </footer>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-hero {
    position: relative;
    height: 360px;
    overflow: hidden;
  }

  .blog-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(26,53,120,0.3), rgba(26,53,120,0.5));
  }

  .blog-post {
    max-width: 760px;
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .blog-post__header {
    margin-bottom: var(--space-10);
  }

  .blog-post__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .blog-post__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .blog-post__body {
    line-height: var(--leading-relaxed);
  }

  .blog-post__body :global(h2),
  .blog-post__body :global(h3) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .blog-post__body :global(p) {
    margin-bottom: var(--space-6);
  }

  .blog-post__body :global(img:not(.lightbox-thumb__img)) {
    border-radius: var(--radius-lg);
    margin-block: var(--space-8);
  }

  .blog-post__body :global(.blog-figure) {
    width: 100%;
    max-width: 50%;
    margin-block-end: var(--space-2);
  }

  .blog-post__body :global(.blog-figure img) {
    width: 100%;
    margin: 0;
    display: block;
    border-radius: 0.75rem;
    corner-shape: bevel;
  }

  .blog-post__body :global(.blog-figure figcaption) {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .blog-post__body :global(.blog-figure--left) {
    float: left;
    margin-right: var(--space-6);
  }

  .blog-post__body :global(.blog-figure--right) {
    float: right;
    margin-left: var(--space-6);
  }

  .blog-post__body :global(.blog-figure--center) {
    float: none;
    margin-inline: auto;
  }

  .blog-post__body::after {
    content: '';
    display: block;
    clear: both;
  }

  @media (max-width: 900px) {
    .blog-post__body :global(.blog-figure) {
      float: none;
      max-width: 100%;
      margin-inline: 0;
    }
  }

  .blog-post__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .parallax {
    position: relative;
    min-height: 65vh;
    min-height: 65dvh;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .parallax .blog-post__header {
    width: 100%;
    position: absolute;
    bottom: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    font-size: var(--text-5xl);
    padding-block: var(--space-16);
    /* Add vertical deep blue linear gradient overlay */
    background: linear-gradient(to top, rgba(26,53,120,0.9), rgba(0,0,0,0));
    margin: 0;
  }
  .parallax .blog-post__title,
  .parallax .blog-post__meta {
    color: white;
  }

  .parallax .container {
    max-width: 760px;
  }
</style>
