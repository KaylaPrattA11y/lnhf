---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';

const { title, description, date, author, featuredImage, ogImage } = Astro.props;
const resolvedOgImage =
  (typeof ogImage === 'string' ? ogImage : undefined) ??
  (typeof featuredImage === 'string' ? featuredImage : featuredImage?.src);
---

<BaseLayout 
  title={title} 
  description={description} 
  ogImage={resolvedOgImage}
>
  <Nav slot="nav" />

  {featuredImage && (
    <div class="blog-hero" aria-hidden="true">
      <img
        src={featuredImage}
        alt=""
        class="blog-hero__image"
        loading="eager"
        width="1280"
        height="500"
      />
      <div class="blog-hero__overlay"></div>
    </div>
  )}

  <article class="bg-arabesque">
    <div class="blog-post container">
      <header class="blog-post__header">
        <h1 class="blog-post__title">{title}</h1>
        {(date || author) && (
          <p class="blog-post__meta">
            {date && (
              <time datetime={date.toISOString()}>
                {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )}
            {date && author && <span aria-hidden="true"> · </span>}
            {author && <span>By {author}</span>}
          </p>
        )}
        <hr class="divider divider--left" aria-hidden="true" />
      </header>
  
      <div class="blog-post__body prose">
        <slot />
      </div>
  
      <footer class="blog-post__footer">
        <a href="/blog/" class="btn btn--secondary btn--sm">&larr; Back to Blog</a>
      </footer>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-hero {
    position: relative;
    height: 360px;
    overflow: hidden;
  }

  .blog-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(26,53,120,0.3), rgba(26,53,120,0.5));
  }

  .blog-post {
    max-width: 760px;
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .blog-post__header {
    margin-bottom: var(--space-10);
  }

  .blog-post__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .blog-post__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .blog-post__body {
    line-height: var(--leading-relaxed);
  }

  .blog-post__body :global(h2),
  .blog-post__body :global(h3) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .blog-post__body :global(p) {
    margin-bottom: var(--space-6);
  }

  .blog-post__body :global(img) {
    border-radius: var(--radius-lg);
    margin-block: var(--space-8);
  }

  .blog-post__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
</style>
