---
// Supports weights 300-700
import '@fontsource-variable/cormorant-garamond/wght.css';
// Supports weights 100-900
import '@fontsource-variable/jost/wght.css';
import { SEO, type Props as SEOProps, type TwitterCardType } from 'astro-seo';

export interface BaseLayoutProps {
  title: string;
  description: string;
  ogImage?: string;
  ogImageSquare?: string;
  openGraph?: SEOProps['openGraph'];
  twitter?: SEOProps['twitter'];
  canonicalUrl?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  robots?: {
    noindex?: boolean;
    nofollow?: boolean;
    noarchive?: boolean;
    nosnippet?: boolean;
    maxSnippet?: number;
  };
}

const defaultTitle = 'Lower Notley Hall Farm';
const defaultDescription = 'A charming waterfront wedding venue in Southern Maryland, offering rustic elegance and picturesque views for your special day.';

const { 
  title, 
  description, 
  ogImage,
  ogImageSquare,
  schema, 
  robots, 
  openGraph,
  twitter,
  canonicalUrl = Astro.url.href 
} = Astro.props as BaseLayoutProps;

const siteTitle = defaultTitle;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;

const toStringValue = (value: unknown): string | undefined => {
  if (!value) return undefined;
  return String(value);
};

const toAbsoluteUrl = (value?: string) => {
  if (!value) return undefined;
  try {
    return new URL(value).toString();
  } catch {
    return new URL(value, siteOrigin).toString();
  }
};

const ogImageUrl = toAbsoluteUrl("/images/og-image.png");

const canonicalAbsoluteUrl = toAbsoluteUrl(canonicalUrl) ?? Astro.url.href;

const openGraphImage =
  toAbsoluteUrl(toStringValue(openGraph?.basic?.image)) ??
  toAbsoluteUrl(ogImage) ??
  ogImageUrl;

const openGraphUrl =
  toAbsoluteUrl(toStringValue(openGraph?.basic?.url)) ??
  canonicalAbsoluteUrl;

const mergedOpenGraph: SEOProps['openGraph'] = {
  basic: {
    title: openGraph?.basic?.title ?? fullTitle,
    type: openGraph?.basic?.type ?? 'website',
    image: openGraphImage,
    url: openGraphUrl,
  },
  optional: {
    description,
    siteName: siteTitle,
    ...openGraph?.optional,
  },
  image: openGraph?.image,
  article: openGraph?.article,
};

const mergedTwitter: SEOProps['twitter'] = {
  card: twitter?.card ?? ('summary_large_image' as TwitterCardType),
  title: twitter?.title ?? fullTitle,
  description: twitter?.description ?? description ?? defaultDescription,
  image:
    toAbsoluteUrl(toStringValue(twitter?.image)) ??
    toAbsoluteUrl(ogImageSquare) ??
    ogImageUrl,
  site: twitter?.site,
  creator: twitter?.creator,
  imageAlt: twitter?.imageAlt,
};

const websiteUrl = toAbsoluteUrl(import.meta.env.BASE_URL);
const logoUrl = toAbsoluteUrl("/images/logo.svg");
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const organizationSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "EventVenue",
  name: siteTitle,
  description,
  ...(websiteUrl ? { url: websiteUrl } : {}),
  ...(logoUrl ? { image: logoUrl } : {}),
  telephone: "(301) 769-2030",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "236290 Notley Manor Ln",
    addressLocality: "Chaptico",
    addressRegion: "MD",
    postalCode: "20621",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.741895,
    longitude: -73.989308,
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "13:00", closes: "16:00" },
  ],
  sameAs: [
    "https://maps.app.goo.gl/j1eTA4rrkPDHLr2P8",
    "https://www.facebook.com/Lower-Notley-Hall-Farm-Wedding-Venue-1629580437060850/",
    "https://www.theknot.com/marketplace/lower-notley-hall-farm-chaptico-md-1069532",
    "https://lower-notley-hall-farm-llc.wheree.com/",
  ],
};

const webPageSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: fullTitle,
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(websiteUrl
    ? {
        isPartOf: {
          "@type": "WebSite",
          name: siteTitle,
          url: websiteUrl,
        },
      }
    : {}),
};

const customSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaGraph = [organizationSchema, webPageSchema, ...customSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/images/cropped-favicon-32x32.png" sizes="32x32">
    <link rel="icon" href="/images/cropped-favicon-192x192.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/images/cropped-favicon-180x180.png">
    <meta name="msapplication-TileImage" content="/images/cropped-favicon-270x270.png">
    <link rel="preload" as="image" href="/images/cropped-favicon-270x270.png" fetchpriority="high" />
    <SEO
      titleDefault={siteTitle}
      title={fullTitle}
      description={description}
      openGraph={mergedOpenGraph}
      twitter={mergedTwitter}
      noindex={robots?.noindex ?? false}
      nofollow={robots?.nofollow ?? false} 
      noarchive={robots?.noarchive ?? false} 
      canonical={canonicalAbsoluteUrl}
      extend={{
        meta: [
          {
            name: "keywords",
            content: "Lower Notley Hall Farm, wedding venue, waterfront weddings, barn weddings, outdoor ceremonies, wedding packages, wedding pricing, wedding estimator, farm weddings, countryside weddings"
          }
        ]
      }}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to main content (accessibility) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <slot name="above-nav" />

    <slot name="nav">
      <!-- Default nav is injected by individual pages -->
    </slot>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="footer">
      <!-- Default footer is injected by individual pages -->
    </slot>

    <!-- Netlify Identity widget — required for admin auth -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
    <script>
      // Redirect after login/signup — prevents staying on netlify's modal page
      const identity = window.netlifyIdentity;
      if (identity) {
        identity.on('init', (user: unknown) => {
          if (!user) {
            identity.on('login', () => {
              document.location.href = '/admin/bookings';
            });
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
