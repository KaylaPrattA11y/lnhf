---
// Supports weights 300-700
import '@fontsource-variable/cormorant-garamond/wght.css';
// Supports weights 100-900
import '@fontsource-variable/jost/wght.css';
import { createHash } from 'node:crypto';
import { getPublishedCollection } from '@lib/content-status';
import { SEO, type Props as SEOProps, type TwitterCardType } from 'astro-seo';
import type { SortablePricingEntry } from '../lib/pricing-order';

export interface BaseLayoutProps {
  title: string;
  description: string;
  ogImage?: string;
  ogImageSquare?: string;
  openGraph?: SEOProps['openGraph'];
  twitter?: SEOProps['twitter'];
  canonicalUrl?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  robots?: {
    noindex?: boolean;
    nofollow?: boolean;
    noarchive?: boolean;
    nosnippet?: boolean;
    maxSnippet?: number;
  };
}

const defaultTitle = 'Lower Notley Hall Farm';
const defaultDescription = 'A charming waterfront wedding venue in Southern Maryland, offering rustic elegance and picturesque views for your special day.';

const { 
  title, 
  description, 
  ogImage,
  ogImageSquare,
  schema, 
  robots, 
  openGraph,
  twitter,
  canonicalUrl = Astro.url.href 
} = Astro.props as BaseLayoutProps;

const siteTitle = defaultTitle;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;

const toStringValue = (value: unknown): string | undefined => {
  if (!value) return undefined;
  return String(value);
};

const toAbsoluteUrl = (value?: string) => {
  if (!value) return undefined;
  try {
    return new URL(value).toString();
  } catch {
    return new URL(value, siteOrigin).toString();
  }
};

const ogImageUrl =
  toAbsoluteUrl('/uploads/aerial-barn-party.jpg') ??
  new URL('/uploads/aerial-barn-party.jpg', siteOrigin).toString();

const canonicalAbsoluteUrl = toAbsoluteUrl(canonicalUrl) ?? Astro.url.href;

const openGraphImage =
  toAbsoluteUrl(toStringValue(openGraph?.basic?.image)) ??
  toAbsoluteUrl(ogImage) ??
  ogImageUrl;

const openGraphUrl =
  toAbsoluteUrl(toStringValue(openGraph?.basic?.url)) ??
  canonicalAbsoluteUrl;

const mergedOpenGraph: SEOProps['openGraph'] = {
  basic: {
    title: String(openGraph?.basic?.title ?? fullTitle ?? siteTitle),
    type: String(openGraph?.basic?.type ?? 'website'),
    image: String(openGraphImage),
    url: String(openGraphUrl),
  },
  optional: {
    description,
    siteName: siteTitle,
    ...openGraph?.optional,
  },
  image: openGraph?.image,
  article: openGraph?.article,
};

const mergedTwitter: SEOProps['twitter'] = {
  card: twitter?.card ?? ('summary_large_image' as TwitterCardType),
  title: twitter?.title ?? fullTitle,
  description: twitter?.description ?? description ?? defaultDescription,
  image:
    toAbsoluteUrl(toStringValue(twitter?.image)) ??
    toAbsoluteUrl(ogImageSquare) ??
    ogImageUrl,
  site: twitter?.site,
  creator: twitter?.creator,
  imageAlt: twitter?.imageAlt,
};

const websiteUrl = toAbsoluteUrl(import.meta.env.BASE_URL);
const logoUrl = toAbsoluteUrl("/images/logo.svg");
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const organizationSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "EventVenue",
  name: siteTitle,
  description,
  ...(websiteUrl ? { url: websiteUrl } : {}),
  ...(logoUrl ? { image: logoUrl } : {}),
  telephone: "(301) 769-2030",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "236290 Notley Manor Ln",
    addressLocality: "Chaptico",
    addressRegion: "MD",
    postalCode: "20621",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.741895,
    longitude: -73.989308,
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "13:00", closes: "16:00" },
  ],
  sameAs: [
    "https://maps.app.goo.gl/j1eTA4rrkPDHLr2P8",
    "https://www.facebook.com/Lower-Notley-Hall-Farm-Wedding-Venue-1629580437060850/",
    "https://www.theknot.com/marketplace/lower-notley-hall-farm-chaptico-md-1069532",
    "https://lower-notley-hall-farm-llc.wheree.com/",
  ],
};

const webPageSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: fullTitle,
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(websiteUrl
    ? {
        isPartOf: {
          "@type": "WebSite",
          name: siteTitle,
          url: websiteUrl,
        },
      }
    : {}),
};

const customSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaGraph = [organizationSchema, webPageSchema, ...customSchema];

const pricingEntries = await getPublishedCollection('pricing');
const pricingVersionSeed = pricingEntries
  .map((entry: Object & { id: string; data: SortablePricingEntry }) => `${entry.id}:${JSON.stringify(entry.data)}`)
  .sort()
  .join('|');
const pricingCookieVersion = createHash('sha256')
  .update(pricingVersionSeed)
  .digest('hex')
  .slice(0, 12);
const pricingCookieName = `lnhf_pricing_seen_${pricingCookieVersion}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/images/cropped-favicon-32x32.png" sizes="32x32">
    <link rel="icon" href="/images/cropped-favicon-192x192.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/images/cropped-favicon-180x180.png">
    <meta name="msapplication-TileImage" content="/images/cropped-favicon-270x270.png">
    <link rel="preload" as="image" href="/images/cropped-favicon-270x270.png" fetchpriority="high" />
    <SEO
      titleDefault={siteTitle}
      title={fullTitle}
      description={description}
      openGraph={mergedOpenGraph}
      twitter={mergedTwitter}
      noindex={robots?.noindex ?? false}
      nofollow={robots?.nofollow ?? false} 
      noarchive={robots?.noarchive ?? false} 
      canonical={canonicalAbsoluteUrl}
      extend={{
        meta: [
          {
            name: "keywords",
            content: "Lower Notley Hall Farm, wedding venue, waterfront weddings, barn weddings, outdoor ceremonies, wedding packages, wedding pricing, wedding estimator, farm weddings, countryside weddings"
          }
        ]
      }}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
    <script 
      async
      defer
      is:inline
      data-auto-track="true"
      data-do-not-track="false"
      data-cache="true"
      src="https://cloud.umami.is/script.js" 
      data-website-id="82637cef-cb45-4868-9db0-8e287014695d"
    ></script>
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to main content (accessibility) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <slot name="above-nav" />

    <slot name="nav">
      <!-- Default nav is injected by individual pages -->
    </slot>

    <aside
      id="pricing-recommendation"
      class="pricing-recommendation"
      data-cookie-name={pricingCookieName}
      data-pricing-path="/pricing/"
      data-current-path={Astro.url.pathname}
      hidden
      aria-live="polite"
    >
      <div class="pricing-recommendation__inner container">
        <p>
          Looking for pricing? Visit our pricing page and use the estimator to build your package before you submit the contact form.
        </p>
        <div class="pricing-recommendation__actions">
          <a 
            class="btn btn--primary btn--sm" 
            href="/pricing/"
            data-umami-event="Pricing Banner CTA Click"
            data-umami-event-choice="View Pricing Page"
          >
            Use Pricing Estimator
          </a>
          <button 
            class="btn btn--ghost btn--sm" 
            type="button" 
            data-pricing-recommendation-close
            data-umami-event="Pricing Banner CTA Click"
            data-umami-event-choice="Dismiss Banner"
          >
            Dismiss
          </button>
        </div>
      </div>
    </aside>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="footer">
      <!-- Default footer is injected by individual pages -->
    </slot>

    <!-- Netlify Identity widget — required for admin auth -->
    <script 
      is:inline
      src="https://identity.netlify.com/v1/netlify-identity-widget.js" 
      defer></script>
    <script>
      // Redirect after login/signup — prevents staying on netlify's modal page
      const identity = window.netlifyIdentity;
      if (identity) {
        identity.on('init', (user: unknown) => {
          if (!user) {
            identity.on('login', () => {
              document.location.href = '/booking-manager/';
            });
          }
        });
      }
    </script>
    <script>
      const recommendationElement = document.getElementById('pricing-recommendation');
      const root = document.documentElement;
      const navElement = document.getElementById('nav');

      const syncPricingBannerOffset = () => {
        if (!(navElement instanceof HTMLElement)) {
          root.style.setProperty('--pricing-banner-offset', '0px');
          return;
        }

        const navHeight = navElement.getBoundingClientRect().height;
        root.style.setProperty('--pricing-banner-offset', `${Math.max(navHeight, 0)}px`);
      };

      syncPricingBannerOffset();

      if (navElement instanceof HTMLElement && 'ResizeObserver' in window) {
        const navResizeObserver = new ResizeObserver(() => {
          syncPricingBannerOffset();
        });
        navResizeObserver.observe(navElement);
      }

      window.addEventListener('resize', syncPricingBannerOffset);

      if (recommendationElement instanceof HTMLElement) {
        const cookieName = recommendationElement.dataset.cookieName;
        const pricingPath = recommendationElement.dataset.pricingPath ?? '/pricing/';
        const currentPath = recommendationElement.dataset.currentPath ?? window.location.pathname;

        const normalizedPath = (path: string) => {
          if (path.endsWith('/')) return path;
          return `${path}/`;
        };

        const normalizedCurrentPath = normalizedPath(currentPath);
        const isPricingPage = normalizedCurrentPath.startsWith(normalizedPath(pricingPath));
        const isAdminPath = normalizedCurrentPath.startsWith('/admin/') || normalizedCurrentPath.startsWith('/booking-manager/');

        const hasSeenPricing = () => {
          if (!cookieName) return false;
          return document.cookie
            .split(';')
            .map((value) => value.trim())
            .some((value) => value === `${cookieName}=1`);
        };

        const markPricingAsSeen = () => {
          if (!cookieName) return;
          const oneYearFromNow = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000);
          document.cookie = `${cookieName}=1; expires=${oneYearFromNow.toUTCString()}; path=/; SameSite=Lax`;
        };

        if (isPricingPage) {
          markPricingAsSeen();
        } else if (!isAdminPath && !hasSeenPricing()) {
          recommendationElement.hidden = false;
        }

        const closeButton = recommendationElement.querySelector('[data-pricing-recommendation-close]');
        if (closeButton instanceof HTMLButtonElement) {
          closeButton.addEventListener('click', () => {
            recommendationElement.hidden = true;
          });
        }
      }
    </script>
  </body>
</html>

<style>
  .pricing-recommendation {
    position: sticky;
    top: var(--pricing-banner-offset, 0px);
    z-index: 40;
    background: color-mix(in srgb, var(--color-bark) 94%, #000 6%);
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent 70%);
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent 70%);
    color: var(--color-cream);
  }

  .pricing-recommendation__inner {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }

  .pricing-recommendation p {
    margin: 0;
    line-height: 1.4;
    font-size: var(--text-sm);
    color: rgba(245, 240, 232, 0.95);
  }

  .pricing-recommendation__actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .pricing-recommendation .btn--ghost {
    color: var(--color-cream);
  }

  .pricing-recommendation .btn--ghost:hover {
    color: var(--color-cream);
    background: rgba(245, 240, 232, 0.14);
  }

  @media (max-width: 760px) {
    .pricing-recommendation__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .pricing-recommendation__actions {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>

<style is:global>
  @import '../styles/global.css';
</style>
