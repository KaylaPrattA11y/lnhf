---
import BaseLayout from '@layouts/BaseLayout.astro';
import TinaIsland from '@components/tina/TinaIslandCompat.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';
import Hero from '@components/home/Hero.astro';
import StatsBar from '@components/home/StatsBar.astro';
import Blockquote from '@components/home/Blockquote.astro';
import TheSetting from '@components/home/TheSetting.astro';
import LatestPosts from '@components/home/LatestPosts.astro';
import HomeTestimonialsIsland from '@components/tina/HomeTestimonialsIsland.astro';
import TourForm from '@components/home/TourForm.astro';
import { getHomeCarouselSlides, getHomepageTestimonials } from '@lib/tina/data';
import { islands } from '@lib/tina/islands';
import { isEditorRequest } from '@lib/tina/is-editor-request';

const inEditMode = isEditorRequest(Astro.request);
const selectedRelativePath = Astro.url.searchParams.get('entry');
const heroSlides = await getHomeCarouselSlides({ preview: inEditMode, selectedRelativePath });
const testimonials = await getHomepageTestimonials({ preview: inEditMode, selectedRelativePath });

const description =
  'Lower Notley Hall Farm is a historic Southern Maryland waterfront wedding venue in Chaptico, MD—50 miles from Washington, DC. Manor house, reception barn, and Wicomico River views for up to 150 guests.';
---

<BaseLayout
  title="Southern Maryland Waterfront Weddings"
  description={description}
  ogImage="/uploads/aerial-barn-party.jpg"
  ogImageSquare="/uploads/aerial-barn-party.jpg"
>
  <Nav slot="nav" />

  <TinaIsland
    name="homeCarouselContent"
    wrapper={islands.homeCarouselContent.wrapper}
    params={{ entry: selectedRelativePath ?? '' }}
  >
    <Hero slides={heroSlides as Parameters<typeof Hero>[0]['slides']} />
  </TinaIsland>
  <StatsBar />
  <Blockquote />
  <TheSetting />
  <TinaIsland
    name="homeTestimonialsContent"
    wrapper={islands.homeTestimonialsContent.wrapper}
    params={{ entry: selectedRelativePath ?? '' }}
  >
    <HomeTestimonialsIsland
      testimonials={testimonials as Parameters<typeof HomeTestimonialsIsland>[0]['testimonials']}
      inEditMode={inEditMode}
      selectedRelativePath={selectedRelativePath ?? ''}
    />
  </TinaIsland>
  <LatestPosts />
  <TourForm />

  <Footer slot="footer" />
</BaseLayout>
