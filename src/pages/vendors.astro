---
import TinaIsland from '@components/tina/TinaIslandCompat.astro';
import InteriorLayout from '@layouts/InteriorLayout.astro';
import VendorsIsland from '@components/tina/VendorsIsland.astro';
import { islands } from '@lib/tina/islands';
import { getAllVendors } from '@lib/tina/data';
import { isEditorRequest } from '@lib/tina/is-editor-request';

const selectedRelativePath = Astro.url.searchParams.get('entry');
const vendorEntries = await getAllVendors({
  preview: isEditorRequest(Astro.request),
  selectedRelativePath,
});
---

<InteriorLayout
  title="Preferred Vendors"
  description="Our recommended wedding vendors for Lower Notley Hall Farm — photographers, caterers, florists, officiants, and more in Southern Maryland."
  eyebrow="Our Trusted Partners"
  heroTitle="Preferred Vendors"
>
  <p class="interior-hero__lead" slot="hero">
    We've built relationships with exceptional vendors who know our property, share our values,
    and will make your wedding day extraordinary. For our most current recommendations,
    please <a href="/contact/">contact Jack and Cindy</a> directly.
  </p>

  <TinaIsland
    name="vendorsContent"
    wrapper={islands.vendorsContent.wrapper}
    params={{ entry: selectedRelativePath ?? '' }}
  >
    <VendorsIsland vendors={vendorEntries as Parameters<typeof VendorsIsland>[0]['vendors']} />
  </TinaIsland>

</InteriorLayout>

<style>
  .vendors-container { max-width: 900px; }

  .vendor-group { margin-bottom: var(--space-10); }
  .vendor-group__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }
  .vendor-cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .vendor-cards { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  }
  .vendor-card {
    container: vendor-card / inline-size;
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  .vendor-card__header {
    display: grid;
    gap: var(--space-1) var(--space-5);
    @container vendor-card (width >= 300px) {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    margin-block-end: var(--space-3);
  }
  .vendor-card--featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(226,161,32,0.2);
  }
  .vendor-card__badge {
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .vendor-card__name {
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
    margin: 0;
  }
  .vendor-card__name a { 
    color: var(--color-primary);
  }
  .vendor-card__name a:hover { color: var(--color-accent); }
  .vendor-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .vendor-card__details {
    margin-top: var(--space-3);
  }

  .vendor-card__details :global(p) {
    margin: 0 0 var(--space-2);
  }

  .vendor-card__details :global(p:last-child) {
    margin-bottom: 0;
  }

  .vendor-card__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .vendor-card__service-chip {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .vendor-card__service-chip--active {
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-accent) 20%, white);
    border-color: color-mix(in srgb, var(--color-accent) 60%, white);
    font-weight: 600;
  }

  .vendors-note {
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .vendors-note a { color: var(--color-primary); font-weight: 700; word-wrap: break-word; }
</style>
