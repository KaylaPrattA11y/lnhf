---
import { getCollection, render } from 'astro:content';
import InteriorLayout from '@layouts/InteriorLayout.astro';

const vendors = await getCollection('vendors');
const vendorsWithContent = await Promise.all(
  vendors.map(async (vendor) => {
    const { Content } = await render(vendor);
    return {
      vendor,
      Content,
      hasBodyContent: Boolean(vendor.body?.trim()),
    };
  }),
);

const serviceOrder = [
  'Bartending',
  'Catering',
  'Decor',
  'DJs and Entertainment',
  'Florist',
  'Photography',
  'Transportation',
  'Wedding Coordination',
  'Other',
];

const serviceRank = new Map(serviceOrder.map((service, index) => [service, index]));

const normalizedVendors = vendorsWithContent.map(({ vendor, Content, hasBodyContent }) => {
  const data = vendor.data as typeof vendor.data & { vendorType?: string };
  const services = Array.isArray(data.vendorServices)
    ? data.vendorServices
    : data.vendorServices
      ? [data.vendorServices]
      : data.vendorType
        ? [data.vendorType]
        : ['Other'];

  return {
    id: vendor.id,
    ...data,
    vendorServices: services,
    Content,
    hasBodyContent,
  };
});

const vendorsGrouped = normalizedVendors
  .flatMap((vendor) => vendor.vendorServices.map((service) => ({ service, vendor })))
  .sort((a, b) => {
    const byCategory = (serviceRank.get(a.service) ?? 999) - (serviceRank.get(b.service) ?? 999);
    if (byCategory !== 0) return byCategory;
    if (a.vendor.isPreferred !== b.vendor.isPreferred) return a.vendor.isPreferred ? -1 : 1;
    const byName = a.vendor.name.localeCompare(b.vendor.name);
    if (byName !== 0) return byName;
    return (a.vendor.sortOrder ?? 99) - (b.vendor.sortOrder ?? 99);
  })
  .reduce<Record<string, typeof normalizedVendors>>((groups, item) => {
    if (!groups[item.service]) groups[item.service] = [];
    groups[item.service].push(item.vendor);
    return groups;
  }, {});
---

<InteriorLayout
  title="Preferred Vendors"
  description="Our recommended wedding vendors for Lower Notley Hall Farm — photographers, caterers, florists, officiants, and more in Southern Maryland."
  eyebrow="Our Trusted Partners"
  heroTitle="Preferred Vendors"
>
  <p class="interior-hero__lead" slot="hero">
    We've built relationships with exceptional vendors who know our property, share our values,
    and will make your wedding day extraordinary. For our most current recommendations,
    please <a href="/contact/">contact Jack and Cindy</a> directly.
  </p>

  <section class="section bg-arabesque" aria-label="Vendor list">
    <div class="container vendors-container">
      <p>Below is a list of pre-approved and highly recommended Southern Maryland Wedding Venue vendors.</p>
      <p>All other vendors must be approved by Lower Notley Hall Farm and must present licensing and proof of insurance, including photographers as applicable. If your vendor is not approved by Lower Notley Hall Farm, they will not be allowed to work at the venue.</p>
      <p><em>Approval of any vendor not listed below must be approved by Lower Notley Hall Farm, LLC in writing.</em></p>
      {Object.entries(vendorsGrouped).map(([category, items]) => (
        <div class="vendor-group">
          <h2 class="vendor-group__title">{category}</h2>
          <div class="vendor-cards">
            {items.map(v => (
              <article class={`vendor-card${v.isPreferred ? ' vendor-card--featured' : ''}`}>
                <div class="vendor-card__header">
                  <div>
                    <h3 class="vendor-card__name">
                    {v.website ? (
                      <a href={v.website} target="_blank" rel="noopener noreferrer">
                        {v.name}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:inline; margin-left:4px; vertical-align:middle;">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                      </a>
                    ) : v.name}
                    </h3>
                  </div>
                  <div>
                    {v.isPreferred && (
                      <span class="vendor-card__badge">Preferred Partner</span>
                    )}
                  </div>
                </div>
                
                {v.email && (
                  <p class="vendor-card__desc">
                    <strong>Email:</strong>{' '}
                    <a href={`mailto:${v.email.trim()}`}>{v.email.trim()}</a>
                  </p>
                )}
                {v.phone && (
                  <p class="vendor-card__desc">
                    <strong>Phone:</strong>{' '}
                    <a href={`tel:${v.phone.replace(/\D/g, '').trim()}`}>{v.phone.trim()}</a>
                  </p>
                )}
                {v.hasBodyContent && (
                  <div class="vendor-card__desc vendor-card__details">
                    <v.Content />
                  </div>
                )}
                <div class="vendor-card__services" aria-label="Vendor services">
                  {v.vendorServices.map((service) => (
                    <span class={`vendor-card__service-chip${service === category ? ' vendor-card__service-chip--active' : ''}`}>
                      {service}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}

      <div class="vendors-note">
        <p>
          <strong>Note:</strong> Our preferred vendor list is updated regularly.
          Always confirm availability directly with the vendor, and{' '}
          <a href="/contact/">let us know</a> if you'd like our latest recommendations.
        </p>
        <p><strong>General Business Requirements (All Vendors):</strong> Almost every vendor operating in Maryland must obtain a Trader’s License (often called a Business License) from the Clerk of the Circuit Court in the county where the business is located. The cost varies by county (typically $100+ annually). Out-of-State: If you live outside Maryland but work within the state, you may need a non-resident license or to register your business with the Maryland Department of Assessments and Taxation.</p>
        <p><strong>Insurance:</strong> LNHF, just as many other venues, requires the vendors below to carry General Liability Insurance ($1M–$2M coverage) and name the LNHF venue as an “additional insured”. LNHF contracts always require General Liability Insurance. Vendors without insurance will not be allowed to operate at LNHF.</p>
      </div>
    </div>
  </section>

</InteriorLayout>

<style>
  .vendors-container { max-width: 900px; }

  .vendor-group { margin-bottom: var(--space-10); }
  .vendor-group__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }
  .vendor-cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .vendor-cards { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  }
  .vendor-card {
    container: vendor-card / inline-size;
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  .vendor-card__header {
    display: grid;
    gap: var(--space-1) var(--space-5);
    @container vendor-card (width >= 300px) {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    margin-block-end: var(--space-3);
  }
  .vendor-card--featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(226,161,32,0.2);
  }
  .vendor-card__badge {
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .vendor-card__name {
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
    margin: 0;
  }
  .vendor-card__name a { 
    color: var(--color-primary);
  }
  .vendor-card__name a:hover { color: var(--color-accent); }
  .vendor-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .vendor-card__details {
    margin-top: var(--space-3);
  }

  .vendor-card__details :global(p) {
    margin: 0 0 var(--space-2);
  }

  .vendor-card__details :global(p:last-child) {
    margin-bottom: 0;
  }

  .vendor-card__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .vendor-card__service-chip {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .vendor-card__service-chip--active {
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-accent) 20%, white);
    border-color: color-mix(in srgb, var(--color-accent) 60%, white);
    font-weight: 600;
  }

  .vendors-note {
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .vendors-note a { color: var(--color-primary); font-weight: 700; word-wrap: break-word; }
</style>
