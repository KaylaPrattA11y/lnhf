---
import TinaIsland from '@components/tina/TinaIslandCompat.astro';
import InteriorLayout from '@layouts/InteriorLayout.astro';
import PricingTable from '@components/pricing/PricingTable';
import { getPricingEntries } from '@lib/tina/data';
import { comparePricingEntries } from '@lib/pricing-order';
import { islands } from '@lib/tina/islands';
import { isEditorRequest } from '@lib/tina/is-editor-request';

const inEditMode = isEditorRequest(Astro.request);
const selectedRelativePath = Astro.url.searchParams.get('entry');
const rawEntries = await getPricingEntries({ preview: inEditMode, selectedRelativePath });
const entries = rawEntries
  .map((entry, index) => ({
    id: (entry as { _sys?: { relativePath?: string } })._sys?.relativePath ?? `pricing-${index}`,
    name: (entry as { name?: string }).name ?? 'Untitled entry',
    feeType: ((entry as { feeType?: 'static' | 'dynamic' }).feeType ?? 'static'),
    isChecked: (entry as { isChecked?: boolean }).isChecked === true,
    adjustment: Number((entry as { adjustment?: number }).adjustment ?? 0),
    perUnit: (entry as { perUnit?: boolean }).perUnit ?? false,
    sortOrder: Number((entry as { sortOrder?: number }).sortOrder ?? 99),
    description: (entry as { description?: string }).description,
    maxUnits: (entry as { maxUnits?: number }).maxUnits,
    billingTreatment: (entry as { billingTreatment?: 'includedInTotals' | 'returnedLater' | 'informationalOnly' }).billingTreatment ?? 'includedInTotals',
  }))
  .sort(comparePricingEntries);
---

<InteriorLayout
  title="Wedding Pricing"
  description="Transparent wedding pricing for Lower Notley Hall Farm. Use our interactive estimator to build your package."
  eyebrow="Transparent Pricing"
  heroTitle="Wedding Package Estimator"
  heroMaxWidth="760px"
>
  <Fragment slot="hero">
    <p class="interior-hero__lead">
      Check or uncheck the features below to build your custom estimate. All packages are subject to
      a separate refundable damage deposit and a non-refundable retaining fee to hold your date.
    </p>
    <p class="interior-hero__note">
      Prices reflect current rates and may be updated. Contact us to confirm your quote.
    </p>
  </Fragment>

  <TinaIsland
    name="pricingContent"
    wrapper={islands.pricingContent.wrapper}
    params={{ entry: selectedRelativePath ?? '' }}
  >
    <section class="section pricing-tool-section bg-arabesque" aria-label="Pricing estimator">
      <div class="container" style="max-width: 960px;">
        <PricingTable entries={entries} client:only="react" />
      </div>
    </section>
  </TinaIsland>

</InteriorLayout>

<style>
  .container {
    @container (width < 600px) {
      --padding-x: 0;
    }
  }
</style>
