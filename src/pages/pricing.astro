---
import { getCollection } from 'astro:content';
import InteriorLayout from '@layouts/InteriorLayout.astro';
import PricingTable from '@components/pricing/PricingTable';
import { comparePricingEntries } from '@lib/pricing-order';

const rawEntries = await getCollection('pricing');
const entries = rawEntries
  .map((e) => ({
    id: e.id,
    name: e.data.name,
    feeType: e.data.feeType,
    isChecked: e.data.isChecked === true,
    adjustment: e.data.adjustment ?? 0,
    perUnit: e.data.perUnit ?? false,
    sortOrder: e.data.sortOrder ?? 99,
    description: e.data.description,
    maxUnits: e.data.maxUnits,
    billingTreatment: e.data.billingTreatment ?? 'includedInTotals',
  }))
  .sort(comparePricingEntries);
---

<InteriorLayout
  title="Wedding Pricing"
  description="Transparent wedding pricing for Lower Notley Hall Farm. Use our interactive estimator to build your package."
  eyebrow="Transparent Pricing"
  heroTitle="Wedding Package Estimator"
  heroMaxWidth="760px"
>
  <Fragment slot="hero">
    <p class="interior-hero__lead">
      Check or uncheck the features below to build your custom estimate. All packages are subject to
      a separate refundable damage deposit and a non-refundable retaining fee to hold your date.
    </p>
    <p class="interior-hero__note">
      Prices reflect current rates and may be updated. Contact us to confirm your quote.
    </p>
  </Fragment>

  <section class="section pricing-tool-section bg-arabesque" aria-label="Pricing estimator">
    <div class="container" style="max-width: 960px;">
      <PricingTable entries={entries} client:only="react" />
    </div>
  </section>

</InteriorLayout>

<style>
  .container {
    @container (width < 600px) {
      --padding-x: 0;
    }
  }
</style>
