---
import TinaIsland from '@components/tina/TinaIslandCompat.astro';
import BlogLayout from '@layouts/BlogLayout.astro';
import LightboxGallery from '@components/about/LightboxGallery';
import BlogBodyIsland from '@components/tina/BlogBodyIsland.astro';
import { islands } from '@lib/tina/islands';
import { getBlogPost } from '@lib/tina/data';
import { isEditorRequest } from '@lib/tina/is-editor-request';

export const prerender = false;

const postSlug = Astro.params.slug?.trim() ?? '';

if (!postSlug) {
  return new Response('Not Found', { status: 404 });
}

let tinaPost;

try {
  tinaPost = await getBlogPost(postSlug);
} catch {
  return new Response('Not Found', { status: 404 });
}

const editablePost = tinaPost.data?.blog;
const inEditMode = isEditorRequest(Astro.request);

if (!editablePost || (!inEditMode && editablePost.status === 'draft')) {
  return new Response('Not Found', { status: 404 });
}

const postDate = editablePost.pubDate ? new Date(editablePost.pubDate) : undefined;

type BlogGalleryItem = {
  image: string;
  pubDate?: Date;
  title?: string;
  caption?: string;
  credit?: string;
};

const normalizedGallery: BlogGalleryItem[] = [];
for (const item of editablePost.photoGallery ?? []) {
  if (!item || !item.image) continue;
  normalizedGallery.push({
    image: item.image,
    pubDate: item.pubDate ? new Date(item.pubDate) : undefined,
    title: item.title,
    caption: item.caption ?? undefined,
    credit: item.credit ?? undefined,
  });
}
normalizedGallery.sort((a, b) => (b.pubDate?.valueOf() ?? 0) - (a.pubDate?.valueOf() ?? 0));

const galleryImages = normalizedGallery.map((item, index) => ({
  id: `${postSlug}-gallery-${index}`,
  data: {
    image: item.image,
    pubDate: item.pubDate ?? postDate ?? new Date(),
    title: item.title ?? `Gallery photo ${index + 1}`,
    caption: item.caption,
    credit: item.credit,
  },
}));
---

<BlogLayout
  title={editablePost.title}
  description={editablePost.excerpt ?? `Read about ${editablePost.title} on the Lower Notley Hall Farm blog.`}
  ogImage={editablePost.featuredImage ?? undefined}
>
  <TinaIsland name="blogBody" wrapper={islands.blogBody.wrapper} params={{ slug: postSlug }} primary>
    <BlogBodyIsland data={editablePost} slug={postSlug} />
  </TinaIsland>

  {galleryImages.length > 0 && (
    <section class="blog-gallery" aria-label="Photo gallery">
      <h2 class="blog-gallery__title">Photo Gallery</h2>
      <LightboxGallery client:load images={galleryImages} columns={3} />
    </section>
  )}

</BlogLayout>

<style>
  .blog-gallery {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 2px solid var(--color-border);
  }
  .blog-gallery__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
  }
</style>
