---
import { getCollection, render } from 'astro:content';
import BlogLayout from '@layouts/BlogLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';
import LightboxGallery from '@components/about/LightboxGallery';
import BlogFigure from '@components/blog/BlogFigure.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

type BlogGalleryItem = {
  image: string;
  pubDate?: Date;
  title?: string;
  caption?: string;
  credit?: string;
};

const normalizedGallery: BlogGalleryItem[] = (post.data.photoGallery ?? [])
  .map((item) => {
    if (typeof item === 'string') {
      return {
        image: item,
      };
    }

    return {
      image: item.image,
      pubDate: item.pubDate,
      title: item.title,
      caption: item.caption,
      credit: item.credit,
    };
  })
  .filter((item) => Boolean(item.image))
  .sort((a, b) => (b.pubDate?.valueOf() ?? 0) - (a.pubDate?.valueOf() ?? 0));

const galleryImages = normalizedGallery
  .filter((item) => Boolean(item.image))
  .map((item, index) => ({
    id: `${post.id}-gallery-${index}`,
    data: {
      image: item.image as string,
      pubDate: item.pubDate ?? post.data.pubDate,
      title: item.title ?? `Gallery photo ${index + 1}`,
      caption: item.caption,
      credit: item.credit,
    },
  }));
---

<BlogLayout
  title={post.data.title}
  description={post.data.excerpt ?? `Read about ${post.data.title} on the Lower Notley Hall Farm blog.`}
  date={post.data.pubDate}
  author={post.data.author}
  featuredImage={post.data.featuredImage}
  ogImage={post.data.featuredImage}
  slug={post.id.replace(/\.mdx?$/, '')}
>
  <Nav slot="nav" />

  <Content components={{ BlogFigure }} />

  {galleryImages.length > 0 && (
    <section class="blog-gallery" aria-label="Photo gallery">
      <h2 class="blog-gallery__title">Photo Gallery</h2>
      <LightboxGallery client:load images={galleryImages} columns={3} />
    </section>
  )}

  <Footer slot="footer" />
</BlogLayout>

<style>
  .blog-gallery {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 2px solid var(--color-border);
  }
  .blog-gallery__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
  }
</style>
