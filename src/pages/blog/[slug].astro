---
import { getCollection, render } from 'astro:content';
import BlogLayout from '@layouts/BlogLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.excerpt ?? `Read about ${post.data.title} on the Lower Notley Hall Farm blog.`}
  date={post.data.date}
  author={post.data.author}
  featuredImage={post.data.featuredImage}
  ogImage={post.data.featuredImage}
>
  <Nav slot="nav" />

  <Content />

  {post.data.photoGallery && post.data.photoGallery.length > 0 && (
    <section class="blog-gallery" aria-label="Photo gallery">
      <h2 class="blog-gallery__title">Photo Gallery</h2>
      <div class="blog-gallery__grid">
        {post.data.photoGallery.map((src: string, i: number) => (
          <figure class="blog-gallery__item">
            <img
              src={src}
              alt={`Gallery photo ${i + 1} for ${post.data.title}`}
              loading="lazy"
              class="blog-gallery__img"
              width="600"
              height="400"
            />
          </figure>
        ))}
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BlogLayout>

<style>
  .blog-gallery {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 2px solid var(--color-border);
  }
  .blog-gallery__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
  }
  .blog-gallery__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .blog-gallery__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .blog-gallery__item { margin: 0; }
  .blog-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
    border-radius: var(--radius-md);
  }
</style>
