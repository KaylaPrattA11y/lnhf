---
import BaseLayout from '@layouts/BaseLayout.astro';

const redirectTarget = `/blog/page/1/`;

const pageTitle = "Blog";
const pageDesc = "News, updates, and stories from Lower Notley Hall Farm — a Southern Maryland waterfront wedding venue.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <script is:inline define:vars={{ redirectTarget }}>
    window.location.replace(redirectTarget);
  </script>
</BaseLayout>