---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';

const faqEntries = await getCollection('faqs');
const sorted = faqEntries.sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to the most common questions about booking, pricing, policies, and amenities at Lower Notley Hall Farm."
>
  <Nav slot="nav" />

  <section class="faqs-hero section section--sm" aria-label="FAQs hero">
    <div class="container" style="text-align: center; max-width: 700px;">
      <span class="section-header__eyebrow">Need Answers?</span>
      <h1 class="faqs-hero__title">Frequently Asked Questions</h1>
      <hr class="divider" aria-hidden="true" />
      <p class="faqs-hero__lead">
        We've collected the questions we hear most often. Don't see yours? We're happy to help —
        <a href="/contact">reach out any time</a> or call <a href="tel:3017692030">(301) 769-2030</a>.
      </p>
    </div>
  </section>

  <section class="section section--cream" aria-label="FAQ accordion">
    <div class="container faqs-container">
      <div class="faq-list" role="list">
        {sorted.map(async entry => {
          const { Content } = await entry.render();
          const btnId   = `faq-btn-${entry.slug}`;
          const panelId = `faq-panel-${entry.slug}`;
          return (
            <div class="faq-item" role="listitem">
              <h2 class="faq-item__heading">
                <button
                  id={btnId}
                  class="faq-item__trigger"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-faq-trigger
                >
                  <span class="faq-item__question">{entry.data.question}</span>
                  <span class="faq-item__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </span>
                </button>
              </h2>
              <div id={panelId} role="region" aria-labelledby={btnId} class="faq-item__panel" hidden>
                <div class="faq-item__answer">
                  <Content />
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="faqs-footer-note">
        <p>
          <strong>Still have questions?</strong> <a href="/contact">Contact Jack and Cindy</a> — we love
          talking about the farm and what we can do for you.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]').forEach(btn => {
    const panelId = btn.getAttribute('aria-controls');
    const panel   = panelId ? document.getElementById(panelId) as HTMLElement | null : null;
    if (!panel) return;
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      panel.hidden = isOpen;
      btn.closest('.faq-item')?.classList.toggle('is-open', !isOpen);
    });
  });
</script>

<style>
  .faqs-hero { background: var(--color-primary-dark); color: var(--color-white); }
  .faqs-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--color-white);
    margin-bottom: var(--space-5);
  }
  .faqs-hero__lead {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.85);
    line-height: var(--leading-relaxed);
  }
  .faqs-hero__lead a { color: var(--color-accent); font-weight: 700; }
  .faqs-hero .section-header__eyebrow { color: var(--color-accent); }
  .faqs-hero .divider { border-color: rgba(255,255,255,0.2); }

  .faqs-container { max-width: 840px; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .faq-item {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item.is-open {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }
  .faq-item__heading { margin: 0; }
  .faq-item__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background var(--transition-fast);
  }
  .faq-item__trigger:hover { background: var(--color-gray-100); }
  .faq-item.is-open .faq-item__trigger { background: var(--color-gray-100); }
  .faq-item__trigger:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }
  .faq-item__question {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-primary-dark);
    line-height: var(--leading-snug);
  }
  .faq-item__icon {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform var(--transition-base);
  }
  .faq-item.is-open .faq-item__icon { transform: rotate(180deg); }
  .faq-item__panel {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .faq-item__answer {
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  .faq-item__answer :global(p)  { margin-bottom: var(--space-3); }
  .faq-item__answer :global(a)  { color: var(--color-primary); font-weight: 700; }
  .faq-item__answer :global(ul), .faq-item__answer :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .faqs-footer-note {
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    text-align: center;
    font-size: var(--text-base);
  }
  .faqs-footer-note a { color: var(--color-primary); font-weight: 700; }
</style>
