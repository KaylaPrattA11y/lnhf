---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Lower Notley Hall Farm. We'd love to answer your questions and help plan your wedding or special event."
>
  <Nav slot="nav" />

  <section class="contact-hero section section--sm" aria-label="Contact hero">
    <div class="container" style="text-align: center; max-width: 700px;">
      <span class="section-header__eyebrow">We'd Love to Hear from You</span>
      <h1 class="contact-hero__title">Get in Touch</h1>
      <hr class="divider" aria-hidden="true" />
      <p class="contact-hero__lead">
        Have a question before you book? Curious whether we can accommodate your vision?
        Check our <a href="/faqs/">FAQs</a> first — you may find your answer in seconds.
        Otherwise, fill out the form or give us a call.
      </p>
    </div>
  </section>

  <section class="section bg-arabesque contact-section" aria-label="Contact information and form">
    <div class="container contact-grid">

      <!-- Contact info panel -->
      <aside class="contact-info" aria-label="Contact details">
        <h2 class="contact-info__title">Lower Notley Hall Farm</h2>
        <ul class="contact-info__list">
          <li class="contact-info__item">
            <svg class="contact-info__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <div>
              <strong>Address</strong><br />
              36290 Notley Manor Ln<br />
              Chaptico, MD 20621
            </div>
          </li>
          <li class="contact-info__item">
            <svg class="contact-info__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11.5 19.79 19.79 0 0 1 1.61 2.84 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.55a16 16 0 0 0 6.54 6.54l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <div>
              <strong>Phone</strong><br />
              <a href="tel:3017692030">(301) 769-2030</a>
            </div>
          </li>
          <li class="contact-info__item">
            <svg class="contact-info__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <div>
              <strong>Tours</strong><br />
              Sundays · ~1 hour each<br />
              48 hours cancellation notice
            </div>
          </li>
          <li class="contact-info__item">
            <svg class="contact-info__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            <div>
              <strong>Facebook</strong><br />
              <a href="https://www.facebook.com/Lower-Notley-Hall-Farm-Wedding-Venue-1629580437060850" target="_blank" rel="noopener noreferrer">
                Lower Notley Hall Farm
              </a>
            </div>
          </li>
        </ul>

        <div class="contact-info__cta">
          <a href="/booking/" class="btn btn--primary">Book a Tour</a>
        </div>
      </aside>

      <!-- Contact form -->
      <div class="contact-form-wrap">
        <h2 class="contact-form__title">Send Us a Message</h2>
        <form
          name="contact"
          method="POST"
          action="/contact/success/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
          novalidate
          aria-label="General contact form"
          id="contact-form"
        >
          <div class="bot-field" aria-hidden="true">
            <label>Do not fill: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="form-name" value="contact" />

          <div class="form-group">
            <label class="form-label" for="c-name">
              Full Name <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              class="form-input"
              type="text"
              id="c-name"
              name="name"
              required
              autocomplete="name"
              aria-required="true"
              aria-describedby="c-name-error"
              placeholder="Your full name"
            />
            <span class="form-error" id="c-name-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-group">
            <label class="form-label" for="c-email">
              Email Address <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              class="form-input"
              type="email"
              id="c-email"
              name="email"
              required
              autocomplete="email"
              aria-required="true"
              aria-describedby="c-email-error"
              placeholder="your@email.com"
            />
            <span class="form-error" id="c-email-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-group">
            <label class="form-label" for="c-phone">Phone Number</label>
            <input
              class="form-input"
              type="tel"
              id="c-phone"
              name="phone"
              autocomplete="tel"
              placeholder="(301) 555-0100"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="c-subject">Subject</label>
            <select class="form-select" id="c-subject" name="subject">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Pricing & Packages">Pricing & Packages</option>
              <option value="Tour Booking">Tour Booking</option>
              <option value="Vendors">Vendors</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="c-message">
              Message <span class="required" aria-hidden="true">*</span>
            </label>
            <textarea
              class="form-textarea"
              id="c-message"
              name="message"
              rows="5"
              required
              maxlength="500"
              aria-required="true"
              aria-describedby="c-message-error"
              placeholder="How can we help? (500 character max)"
            ></textarea>
            <span class="contact-form__char-note">Maximum 500 characters</span>
            <span class="form-error" id="c-message-error" role="alert" aria-live="polite"></span>
          </div>

          <button type="submit" class="btn btn--primary btn--lg">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const fields = [
      {
        el: document.getElementById('c-name') as HTMLInputElement,
        errorEl: document.getElementById('c-name-error') as HTMLElement,
        validate: (v: string) => v.trim() ? '' : 'Please enter your full name.',
      },
      {
        el: document.getElementById('c-email') as HTMLInputElement,
        errorEl: document.getElementById('c-email-error') as HTMLElement,
        validate: (v: string) => {
          if (!v.trim()) return 'Please enter your email address.';
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return 'Please enter a valid email address.';
          return '';
        },
      },
      {
        el: document.getElementById('c-message') as HTMLTextAreaElement,
        errorEl: document.getElementById('c-message-error') as HTMLElement,
        validate: (v: string) => v.trim() ? '' : 'Please enter a message.',
      },
    ];

    const showError = (field: typeof fields[number], msg: string) => {
      field.errorEl.textContent = msg;
      field.el.classList.toggle('form-input--error', !!msg);
      field.el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    // Clear error as user corrects each field
    fields.forEach(field => {
      field.el.addEventListener('input', () => showError(field, field.validate(field.el.value)));
    });

    form.addEventListener('submit', (e) => {
      let firstInvalid: HTMLElement | null = null;

      fields.forEach(field => {
        const msg = field.validate(field.el.value);
        showError(field, msg);
        if (msg && !firstInvalid) firstInvalid = field.el;
      });

      if (firstInvalid) {
        e.preventDefault();
        (firstInvalid as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
        (firstInvalid as HTMLElement).focus();
      }
    });
  }
</script>

<style>
  .contact-hero { background: var(--color-primary-dark); color: var(--color-white); }
  .contact-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--color-white);
    margin-bottom: var(--space-5);
  }
  .contact-hero__lead {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.85);
    line-height: var(--leading-relaxed);
  }
  .contact-hero__lead a { color: var(--color-accent); font-weight: 700; }
  .contact-hero .section-header__eyebrow { color: var(--color-accent); }
  .contact-hero .divider { border-color: rgba(255,255,255,0.2); }

  .contact-grid {
    display: grid;
    gap: var(--space-12);
    align-items: start;
    @container main (width < 600px) {
      width: calc(100% + var(--padding-x) * 2);
      margin-inline: calc(var(--padding-x) * -1) 0;
    }
  }
  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 360px 1fr; }
  }

  /* Info panel */
  .contact-info {
    background: var(--color-primary-dark);
    color: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
  }
  .contact-info__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-white);
    margin-bottom: var(--space-6);
  }
  .contact-info__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .contact-info__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: rgba(255,255,255,0.85);
  }
  .contact-info__item strong { color: var(--color-accent); display: block; margin-bottom: 2px; }
  .contact-info__item a { color: rgba(255,255,255,0.85); }
  .contact-info__item a:hover { color: var(--color-accent); }
  .contact-info__icon { flex-shrink: 0; margin-top: 2px; color: var(--color-accent); }

  /* Form */
  .contact-form-wrap {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
  }
  .contact-form__title {
    font-size: var(--text-2xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
  }
  .contact-form__char-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    display: block;
  }
  .contact-form .form-group { margin-bottom: var(--space-5); }

  .form-error {
    display: block;
    font-size: var(--text-sm);
    color: #b91c1c;
    min-height: 1em;
  }
  .form-input--error {
    border-color: #b91c1c;
    outline-color: #b91c1c;
  }
</style>
