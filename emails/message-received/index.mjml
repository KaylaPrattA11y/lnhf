<mjml>
  <mj-head>
    <mj-font name="Cormorant Garamond"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&display=swap" />
    <mj-font name="Jost"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;600;700&display=swap" />
    <mj-style inline="inline">
      a {
        color: blue;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f0e8">
    <mj-section background-color="#2b2b2c" full-width="full-width">
      <mj-column>
        <mj-navbar base-url="https://lowernotleyhallfarm.netlify.app" hamburger="hamburger" ico-color="#ffffff">
            <mj-navbar-link href="/about/" color="#ffffff">About</mj-navbar-link>
            <mj-navbar-link href="/booking/" color="#ffffff">Book a Tour</mj-navbar-link>
            <mj-navbar-link href="/pricing/" color="#ffffff">Pricing</mj-navbar-link>
            <mj-navbar-link href="/faqs/" color="#ffffff">FAQs</mj-navbar-link>
        </mj-navbar>
      </mj-column>
    </mj-section>
    <mj-section background-color="#faf8f3">
      <mj-column>
        <mj-image src="/images/logo.png" />
        <!-- placeholder logo -->
        <mj-image src="https://unsplash.it/200/225" width="200px" />
      </mj-column>
      <mj-column>
        <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-weight="400">
          <h1 style="margin: 0;">Lower Notley Hall Farm</h1>
        </mj-text>
        <mj-text 
          font-family="'Jost', Helvetica, Arial, sans-serif" 
          font-size="14px" 
          font-weight="300"
          text-transform="uppercase"
          color="#b5924c"
        >
          Southern Maryland Waterfront Weddings
        </mj-text>
        <mj-divider border-color="#b5924c"></mj-divider>
        <mj-text 
          font-family="'Jost', Helvetica, Arial, sans-serif" 
          font-size="14px" 
          font-weight="300"
          color="#000000"
        >
          <p>36290 Notley Manor Ln, Chaptico, MD 20621</p>
          <p>(301) 769-2030</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#faf8f3" >
      <mj-column>
        <mj-text font-size="20px" color="#b5924c" font-family="'Jost', Helvetica, Arial, sans-serif">{{ name }}, thank you for contacting Lower Notley Hall Farm.</mj-text>
        <mj-text font-size="16px" font-weight="300" color="#000000" font-family="'Jost', Helvetica, Arial, sans-serif">Jack and Cynthia will get back to you as soon as possible.</mj-text>
        <mj-text font-size="16px" font-weight="300" color="#000000" font-family="'Jost', Helvetica, Arial, sans-serif">In the meantime, feel free to explore our website and <a href="https://lowernotleyhallfarm.netlify.app/about/">learn more about our farm</a> and the <a href="https://lowernotleyhallfarm.netlify.app/booking/">tours</a> we offer.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#2b2b2c" full-width="full-width">
      <mj-column>
        <mj-text font-size="14px" color="#ffffff" font-family="'Jost', Helvetica, Arial, sans-serif" align="center">
          &copy; {{ currentYear }} Lower Notley Hall Farm, LLC. All rights reserved.
        </mj-text>
      </mj-column>
  </mj-body>
</mjml>
