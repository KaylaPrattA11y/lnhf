<mjml>
  <mj-head>
    <mj-font name="Cormorant Garamond"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&display=swap" />
    <mj-font name="Jost"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;600;700&display=swap" />
    <mj-style inline="inline">
      a {
        color: blue;
      }
      .bg-arabesque {
        --s: 50px;
        --c1: #f1efe9;
        --c2: #f9f5f1;
        --t: calc(var(--s) / 10);
        --_c: #0000 calc(98% - var(--t)), var(--c1) calc(100% - var(--t)) 98%, #0000;
        --_s: calc(2 * var(--s)) calc(5 * var(--s) / 2);
        --_r0: /var(--_s) radial-gradient(calc(var(--s)/2) at 0 20%,var(--_c));
        --_r1: /var(--_s) radial-gradient(calc(var(--s)/2) at 100% 20%,var(--_c));
        background: #f5f0e8;
        background: 0 0 var(--_r0), calc(-1 * var(--s)) calc(5 * var(--s) / 4) var(--_r0), var(--s) 0 var(--_r1), 0 calc(5 * var(--s) / 4) var(--_r1), conic-gradient(at var(--t) calc(20% + 2 * var(--t)), #0000 75%, var(--c1) 0) calc(var(--t) / -2) calc(var(--s) - var(--t)) / var(--s) calc(5 * var(--s) / 4), repeating-conic-gradient(var(--c2) 0 25%, #0000 0 50%) var(--s) calc(var(--s) / -8) / var(--_s), conic-gradient(from 90deg at var(--t) var(--t), var(--c2) 25%, var(--c1) 0) calc((var(--s) - var(--t)) / 2) calc((var(--s) - var(--t)) / 2) / var(--s) calc(5 * var(--s) / 4);
      }
      .panel {
        background: #faf8f3;
        border-inline: 1px solid #e8e2d6;
      }
    </mj-style>
  </mj-head>
  <mj-body css-class="bg-arabesque">
    <mj-section background-color="#2b2b2c" full-width="full-width">
      <mj-column>
        <mj-navbar base-url="https://lowernotleyhallfarm.com" hamburger="hamburger" ico-color="#ffffff">
            <mj-navbar-link href="/about/" color="#ffffff">About</mj-navbar-link>
            <mj-navbar-link href="/booking/" color="#ffffff">Book a Tour</mj-navbar-link>
            <mj-navbar-link href="/pricing/" color="#ffffff">Pricing</mj-navbar-link>
            <mj-navbar-link href="/faqs/" color="#ffffff">FAQs</mj-navbar-link>
        </mj-navbar>
      </mj-column>
    </mj-section>
    <mj-section css-class="panel">
      <mj-column width="250px">
        <mj-image src="https://lowernotleyhallfarm.com/images/logo.png" />
      </mj-column>
      <mj-column>
        <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-weight="400">
          <h1 style="margin: 0;">Lower Notley Hall Farm</h1>
        </mj-text>
        <mj-text 
          font-family="'Jost', Helvetica, Arial, sans-serif" 
          font-size="14px" 
          font-weight="300"
          text-transform="uppercase"
          color="#b5924c"
        >
          Southern Maryland Waterfront Weddings
        </mj-text>
        <mj-divider border-color="#b5924c"></mj-divider>
        <mj-text 
          font-family="'Jost', Helvetica, Arial, sans-serif" 
          font-size="14px" 
          font-weight="300"
          color="#000000"
        >
          <p>36290 Notley Manor Ln, Chaptico, MD 20621</p>
          <p>(301) 769-2030</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="panel">
      <mj-column>
        <mj-text font-size="20px" color="#b5924c" font-family="'Jost', Helvetica, Arial, sans-serif">{{ name }}, your private tour at Lower Notley Hall Farm has been booked.</mj-text>
        <mj-text font-size="16px" font-weight="300" color="#000000" font-family="'Jost', Helvetica, Arial, sans-serif">We look forward to welcoming you to our farm.</mj-text>
        <mj-text font-size="16px" font-weight="300" color="#000000" font-family="'Jost', Helvetica, Arial, sans-serif">In the meantime, feel free to explore our website and <a href="https://lowernotleyhallfarm.com/about/">learn more about our farm</a> and get answers to <a href="https://lowernotleyhallfarm.com/faqs/">frequently asked questions</a>.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#2b2b2c" full-width="full-width">
      <mj-column>
        <mj-text font-size="14px" color="#ffffff" font-family="'Jost', Helvetica, Arial, sans-serif" align="center">
          &copy; {{ currentYear }} Lower Notley Hall Farm, LLC. All rights reserved.
        </mj-text>
      </mj-column>
  </mj-body>
</mjml>
