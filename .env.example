# Whitelist for access to Netlify admin features such as /booking-manager/
IP_ALLOWLIST= # Comma-separated list of allowed IP addresses

# Netlify Database (Neon) 
NETLIFY_TOURS_DB_URL= # Your Netlify Tours database URL
NETLIFY_WEDDINGS_DB_URL= # Your Netlify Weddings database URL

# TinaCMS Cloud credentials
# Get these from https://app.tina.io → your project → Overview
NEXT_PUBLIC_TINA_CLIENT_ID= # Your TinaCMS client ID
TINA_SEARCH_TOKEN= # Your TinaCMS search token
TINA_TOKEN= # Your TinaCMS token
TINA_PUBLIC_IS_LOCAL=true # Set to true if running TinaCMS locally

# Netlify Identity URL (automatically injected by Netlify, set here for local dev)
# Get from Netlify Dashboard → Site settings → Identity
NETLIFY_IDENTITY_URL=https://lowernotleyhallfarm.com/.netlify/identity # Your Netlify Identity URL (automatically injected by Netlify, set here for local dev)

# Mailgun
# Get these from Mailgun → Sending → Domain → API Keys
NETLIFY_EMAILS_SECRET= # Your Mailgun secret key
NETLIFY_EMAILS_PROVIDER_API_KEY= # Your Mailgun API key
NETLIFY_EMAILS_PROVIDER=mailgun # Your email provider (e.g., mailgun)
NETLIFY_EMAILS_MAILGUN_DOMAIN=lowernotleyhallfarm.com # Your Mailgun domain
NETLIFY_EMAILS_DIRECTORY=emails # Directory for email templates
NETLIFY_EMAILS_MAILGUN_HOST_REGION=non-eu # Your Mailgun host region (e.g., non-eu)
ENABLE_CONFIRMATION_EMAILS=false # Set to true to enable confirmation emails
