# MongoDB Atlas M0 (free tier) connection string
# Get this from MongoDB Atlas → Cluster → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# TinaCMS Cloud credentials
# Get these from https://app.tina.io → your project → Overview
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
TINA_SEARCH=

# Netlify Identity URL (automatically injected by Netlify, set here for local dev)
# Get from Netlify Dashboard → Site settings → Identity
NETLIFY_IDENTITY_URL=https://your-site.netlify.app
